<Window x:Class="blink_o_mat.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:blink_o_mat.Converters"
         Background="{StaticResource WindowBackgroundBrush}"
         Foreground="{StaticResource TextBrush}"
        Title="Frame Preview" Height="1000" Width="1500">
    <Window.Resources>
        <converters:StfSliderValueConverter x:Key="StfSliderValueConverter" />
        <Style x:Key="AcceptedFilterChipStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#223A6B46" />
            <Setter Property="Foreground" Value="#FFE9F8EE" />
            <Setter Property="BorderBrush" Value="#5CA36E" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#2F3FAE63" />
                    <Setter Property="BorderBrush" Value="#7AD68E" />
                </Trigger>
                <Trigger Property="IsChecked" Value="False">
                    <Setter Property="Background" Value="#161616" />
                    <Setter Property="Foreground" Value="#CCBDBDBD" />
                    <Setter Property="BorderBrush" Value="#444" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RejectedFilterChipStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#224E2A2A" />
            <Setter Property="Foreground" Value="#FFF9EAEA" />
            <Setter Property="BorderBrush" Value="#B85C5C" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#33C45F5F" />
                    <Setter Property="BorderBrush" Value="#E07A7A" />
                </Trigger>
                <Trigger Property="IsChecked" Value="False">
                    <Setter Property="Background" Value="#161616" />
                    <Setter Property="Foreground" Value="#CCBDBDBD" />
                    <Setter Property="BorderBrush" Value="#444" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="10" Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="146*" />
            <ColumnDefinition Width="933*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Prev" Width="60" Margin="0,0,6,0" Click="Prev_Click" />
                    <Button Content="Next" Width="60" Margin="0,0,6,0" Click="Next_Click" />
                    <Button Width="38" Margin="0,0,6,0" Click="Smaller_Click" ToolTip="Zoom out">
                        <TextBlock Text="−" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    </Button>
                    <Button Width="38" Margin="0,0,6,0" Click="Fit_Click" ToolTip="Fit to view">
                        <TextBlock Text="⛶" FontSize="14" HorizontalAlignment="Center" />
                    </Button>
                    <Button Width="38" Margin="0,0,6,0" Click="ZoomIn_Click" ToolTip="Zoom in">
                        <TextBlock Text="+" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    </Button>
                    <Button Content="1:1" Width="55" Margin="0,0,10,0" Click="OneToOne_Click" />
                </StackPanel>

                <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding Zoom, StringFormat=Zoom: {0:F2}x}" />

                <Border Grid.Column="2"
                        Margin="12,0,8,0"
                        Padding="8,4,8,6"
                        Background="#1A1A1A"
                        BorderBrush="#333"
                        BorderThickness="1"
                        CornerRadius="6"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="VISIBILITY"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="#666"
                                   Margin="0,0,0,4" />
                        <WrapPanel VerticalAlignment="Center">
                            <ToggleButton IsChecked="{Binding ShowAccepted, Mode=TwoWay}"
                                          Style="{StaticResource AcceptedFilterChipStyle}"
                                          Margin="0,0,6,0"
                                          Padding="12,4"
                                          BorderThickness="1"
                                          FontWeight="SemiBold">
                                <TextBlock Text="Accepted" />
                            </ToggleButton>

                            <ToggleButton IsChecked="{Binding ShowRejected, Mode=TwoWay}"
                                          Style="{StaticResource RejectedFilterChipStyle}"
                                          Margin="0"
                                          Padding="12,4"
                                          BorderThickness="1"
                                          FontWeight="SemiBold">
                                <TextBlock Text="Rejected" />
                            </ToggleButton>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3"
                        Margin="0,0,8,0"
                        Padding="8,4,8,6"
                        Background="#1A1A1A"
                        BorderBrush="#333"
                        BorderThickness="1"
                        CornerRadius="6"
                        VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasFilterChips}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="FILTERS"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="#666"
                                   Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding FilterChips}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Margin="0,0,6,0"
                                                  Padding="10,4"
                                                  BorderThickness="1"
                                                  FontWeight="SemiBold">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Setter Property="Background" Value="#222F426B" />
                                                <Setter Property="Foreground" Value="#FFE8F0FF" />
                                                <Setter Property="BorderBrush" Value="#6D88C4" />
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter Property="Background" Value="#334F78D1" />
                                                        <Setter Property="BorderBrush" Value="#8FB3FF" />
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="False">
                                                        <Setter Property="Background" Value="#161616" />
                                                        <Setter Property="Foreground" Value="#CCBDBDBD" />
                                                        <Setter Property="BorderBrush" Value="#444" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Grid.Row="1"
                       Margin="0,0,0,8"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Text="{Binding Item.FileName}"
                       TextWrapping="Wrap" />

            <Grid Grid.Row="2">
                <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Background="#FF181818">
                    <ScrollViewer x:Name="ImageScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="ImageScrollViewer_PreviewMouseWheel" PreviewMouseLeftButtonDown="ImageScrollViewer_PreviewMouseLeftButtonDown">
                        <Image x:Name="PreviewImage" Source="{Binding Image}" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor" MouseLeftButtonDown="PreviewImage_MouseLeftButtonDown" MouseLeftButtonUp="PreviewImage_MouseLeftButtonUp" MouseRightButtonDown="PreviewImage_MouseRightButtonDown" MouseRightButtonUp="PreviewImage_MouseRightButtonUp" MouseMove="PreviewImage_MouseMove">
                            <Image.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                            </Image.LayoutTransform>
                        </Image>
                    </ScrollViewer>
                </Border>

                <Canvas x:Name="LoupeCanvas" IsHitTestVisible="False">
                    <Border x:Name="LoupeBorder"
                            Visibility="Collapsed"
                            Width="204"
                            Height="140"
                            Background="#FF24323C"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="124" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#FF1A1A1A" BorderBrush="#33000000" BorderThickness="0,0,1,0">
                                <Image x:Name="LoupeImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="8,6,8,6">
                                <TextBlock x:Name="LoupeXText" FontFamily="Consolas" Text="X    0" />
                                <TextBlock x:Name="LoupeYText" FontFamily="Consolas" Text="Y    0" />
                                <TextBlock x:Name="LoupeKText" FontFamily="Consolas" Text="K    0" />
                                <TextBlock x:Name="LoupeMinText" FontFamily="Consolas" Margin="0,6,0,0" Text="Min  0" />
                                <TextBlock x:Name="LoupeMaxText" FontFamily="Consolas" Text="Max  0" />
                                <TextBlock x:Name="LoupeMeanText" FontFamily="Consolas" Text="Mean 0.00" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Canvas>
            </Grid>
        </Grid>

        <Border Grid.Column="2" Margin="12,0,12,0" Padding="8" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="Frames" />
                <TextBlock Grid.Row="1" Margin="0,4,0,8" HorizontalAlignment="Center" Text="{Binding FramePositionText}" />
                <Grid Grid.Row="2"
                      Margin="0,0,0,8"
                      Height="{Binding ElementName=ImageScrollViewer, Path=ActualHeight}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Canvas x:Name="CacheIndicatorCanvas"
                            Grid.Column="0"
                            Width="8"
                            Height="{Binding ElementName=ImageScrollViewer, Path=ActualHeight}"
                            Margin="0,4,0,4"
                            IsHitTestVisible="False" />
                    <Slider x:Name="FrameSlider"
                            Grid.Column="1"
                            Width="24"
                            Height="{Binding ElementName=ImageScrollViewer, Path=ActualHeight}"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Center"
                            Orientation="Vertical"
                            Minimum="0"
                            Maximum="{Binding FrameSliderMaximum}"
                            Value="{Binding FrameSliderValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TickFrequency="1"
                            TickPlacement="Both"
                            IsSnapToTickEnabled="True"
                            IsMoveToPointEnabled="True"
                            IsDirectionReversed="True"
                            SizeChanged="FrameSlider_SizeChanged" />
                </Grid>
                <TextBlock Grid.Row="3" HorizontalAlignment="Center" Text="{Binding FrameCount, StringFormat=Total: {0}}" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="3" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Padding="10" Margin="0,0,0,10" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="SCORE" FontSize="11" Foreground="#9A9A9A" />

                        <Button Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Right"
                                Padding="12,4"
                                Margin="8,0,0,0"
                                FontWeight="SemiBold"
                                Foreground="#F5F5F5"
                                BorderThickness="0"
                                Background="{Binding Item.RejectionStateBrush}"
                                Click="ToggleReject_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="{Binding Item.RejectionStateLabel}" FontWeight="SemiBold" Foreground="#F5F5F5" />
                        </Button>

                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,4,0,2">
                            <TextBlock Text="{Binding Item.ScoreValueText}" FontSize="28" FontWeight="Bold" Foreground="{Binding Item.QualityBrush}" />
                            <TextBlock Text=" / 5" FontSize="14" Foreground="#C8C8C8" VerticalAlignment="Bottom" Margin="4,0,0,3" />
                        </StackPanel>

                        <ProgressBar Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                     Height="10" Margin="0,4,0,0" Minimum="0" Maximum="100"
                                     Value="{Binding Item.ScoreProgressPercent, Mode=OneWay}"
                                     Foreground="{Binding Item.QualityBrush}" Background="#303338" />
                    </Grid>
                </Border>

                <Border Padding="10" Margin="0,0,0,10" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Inspection" Margin="0,0,0,6" />
                        <Expander IsExpanded="True" Margin="0,0,0,8">
                            <Expander.Header>
                                <TextBlock FontWeight="SemiBold" Text="Stretch (STF)" />
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <Button Content="Auto Stretch" HorizontalAlignment="Left" Padding="8,3" Margin="0,0,0,10"
                                        Command="{Binding AutoStretchCommand}" />
                                <TextBlock FontWeight="SemiBold" Text="Shadows" />
                                <DockPanel Margin="0,2,0,8">
                                    <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right"
                                               Text="{Binding StfShadows, StringFormat=F3}" />
                                    <Slider Minimum="0" Maximum="1"
                                            Value="{Binding StfShadows, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource StfSliderValueConverter}, ConverterParameter=low:5}"
                                            TickFrequency="0.001" IsSnapToTickEnabled="False"
                                            Loaded="StfSlider_Loaded" />
                                </DockPanel>
                                <TextBlock FontWeight="SemiBold" Text="Midtones" />
                                <DockPanel Margin="0,2,0,8">
                                    <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right"
                                               Text="{Binding StfMidtones, StringFormat=F3}" />
                                    <Slider Minimum="0" Maximum="1"
                                            Value="{Binding StfMidtones, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource StfSliderValueConverter}, ConverterParameter=low:5}"
                                            TickFrequency="0.001" IsSnapToTickEnabled="False"
                                            Loaded="StfSlider_Loaded" />
                                </DockPanel>
                                <TextBlock FontWeight="SemiBold" Text="Highlights" />
                                <DockPanel Margin="0,2,0,8">
                                    <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right"
                                               Text="{Binding StfHighlights, StringFormat=F3}" />
                                    <Slider Minimum="0" Maximum="1"
                                            Value="{Binding StfHighlights, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource StfSliderValueConverter}, ConverterParameter=high:5}"
                                            TickFrequency="0.001" IsSnapToTickEnabled="False"
                                            Loaded="StfSlider_Loaded" />
                                </DockPanel>
                                <TextBlock FontWeight="SemiBold" Text="Target Background" />
                                <DockPanel Margin="0,2,0,0">
                                    <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right"
                                               Text="{Binding StfTargetBackground, StringFormat=F2}" />
                                    <Slider Minimum="0.01" Maximum="0.5"
                                            Value="{Binding StfTargetBackground, UpdateSourceTrigger=PropertyChanged}"
                                            TickFrequency="0.01" IsSnapToTickEnabled="False" />
                                </DockPanel>
                            </StackPanel>
                        </Expander>

                        <Expander IsExpanded="False">
                            <Expander.Header>
                                <TextBlock FontWeight="SemiBold" Text="ROI" />
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock FontWeight="SemiBold" Text="ROI bias" />
                                <ComboBox ItemsSource="{Binding RoiBiasOptions}" SelectedItem="{Binding RoiBias}" Margin="0,2,0,6" />
                                <TextBlock Text="Hold Ctrl and drag on the image to draw a square ROI. Release to confirm. The selected region is rescaled for the ROI preview in the main window. Escape cancels." TextWrapping="Wrap" FontSize="11" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <Border Padding="10" Margin="0,0,0,10" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                    <Border.Resources>
                        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="0,0,10,0" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Setter Property="Opacity" Value="0.92" />
                        </Style>
                        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="TextAlignment" Value="Right" />
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Foreground" Value="#FFF6E7B0" />
                        </Style>
                    </Border.Resources>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Metrics" Margin="0,0,0,8" />

                        <Border Padding="8" Background="#14000000" BorderBrush="#22000000" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MetricLabelColumn" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource MetricLabelStyle}" Text="Date/time" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource MetricValueStyle}" Text="{Binding Item.ExposureDateTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}, TargetNullValue=n/a}" />

                                <Ellipse Grid.Row="1" Width="8" Height="8" Fill="{Binding Item.FwhmIndicatorBrush}" Margin="0,6,6,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource MetricLabelStyle}" Margin="0,6,10,0" Text="FWHM" />
                                <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource MetricValueStyle}" Margin="0,6,0,0" Text="{Binding Item.Metrics.Fwhm, StringFormat={}{0:F2} px}" />

                                <Ellipse Grid.Row="2" Width="8" Height="8" Fill="{Binding Item.FwhmIndicatorBrush}" Margin="0,6,6,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource MetricLabelStyle}" Margin="0,6,10,0" Text="FWHM sky" />
                                <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource MetricValueStyle}" Margin="0,6,0,0" Text="{Binding Item.Metrics.FwhmArcsec, StringFormat={}{0:F2} as, TargetNullValue=n/a}" />

                                <Ellipse Grid.Row="3" Width="8" Height="8" Fill="{Binding Item.HfrIndicatorBrush}" Margin="0,6,6,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource MetricLabelStyle}" Margin="0,6,10,0" Text="HFR" />
                                <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource MetricValueStyle}" Margin="0,6,0,0" Text="{Binding Item.Metrics.Hfr, StringFormat={}{0:F2} px}" />

                                <Ellipse Grid.Row="4" Width="8" Height="8" Fill="{Binding Item.StarsIndicatorBrush}" Margin="0,6,6,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource MetricLabelStyle}" Margin="0,6,10,0" Text="Stars" />
                                <TextBlock Grid.Row="4" Grid.Column="3" Style="{StaticResource MetricValueStyle}" Margin="0,6,0,0" Text="{Binding Item.Metrics.StarCount, StringFormat={}{0}}" />

                                <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource MetricLabelStyle}" Margin="14,6,10,0" Text="SQM" />
                                <TextBlock Grid.Row="5" Grid.Column="3" Style="{StaticResource MetricValueStyle}" Margin="0,6,0,0" Text="{Binding Item.SqmDisplay}" />

                                <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource MetricLabelStyle}" Margin="14,6,10,0" Text="Sky temp" />
                                <TextBlock Grid.Row="6" Grid.Column="3" Style="{StaticResource MetricValueStyle}" Margin="0,6,0,0" Text="{Binding Item.SkyTempDisplay}" />

                                <Ellipse Grid.Row="7" Width="8" Height="8" Fill="{Binding Item.EccentricityIndicatorBrush}" Margin="0,6,6,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource MetricLabelStyle}" Margin="0,6,10,0" Text="Eccentricity" />
                                <TextBlock Grid.Row="7" Grid.Column="3" Style="{StaticResource MetricValueStyle}" Margin="0,6,0,0" Text="{Binding Item.Metrics.Eccentricity, StringFormat={}{0:F3}}" />

                                <Ellipse Grid.Row="8" Width="8" Height="8" Fill="{Binding Item.MeanBackgroundIndicatorBrush}" Margin="0,6,6,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource MetricLabelStyle}" Margin="0,6,10,0" Text="Mean BG" />
                                <TextBlock Grid.Row="8" Grid.Column="3" Style="{StaticResource MetricValueStyle}" Margin="0,6,0,0" Text="{Binding Item.MeanBackgroundDisplay}" />

                                <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource MetricLabelStyle}" Margin="14,8,10,0" Text="Median" />
                                <TextBlock Grid.Row="9" Grid.Column="3" Style="{StaticResource MetricValueStyle}" Margin="0,8,0,0" Text="{Binding Item.MedianDisplay}" />

                                <TextBlock Grid.Row="10" Grid.Column="1" Style="{StaticResource MetricLabelStyle}" Margin="14,6,10,0" Text="MAD" />
                                <TextBlock Grid.Row="10" Grid.Column="3" Style="{StaticResource MetricValueStyle}" Margin="0,6,0,0" Text="{Binding Item.MadDisplay}" />

                                <TextBlock Grid.Row="11" Grid.Column="1" Style="{StaticResource MetricLabelStyle}" Margin="14,6,10,0" Text="Min" />
                                <TextBlock Grid.Row="11" Grid.Column="3" Style="{StaticResource MetricValueStyle}" Margin="0,6,0,0" Text="{Binding Item.MinDisplay}" />

                                <TextBlock Grid.Row="12" Grid.Column="1" Style="{StaticResource MetricLabelStyle}" Margin="14,6,10,0" Text="Max" />
                                <TextBlock Grid.Row="12" Grid.Column="3" Style="{StaticResource MetricValueStyle}" Margin="0,6,0,0" Text="{Binding Item.MaxDisplay}" />

                                <Ellipse Grid.Row="13" Width="8" Height="8" Fill="{Binding Item.TrailIndicatorBrush}" Margin="0,6,6,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="13" Grid.Column="1" Style="{StaticResource MetricLabelStyle}" Margin="0,6,10,0" Text="Trail conf." />
                                <TextBlock Grid.Row="13" Grid.Column="3" Style="{StaticResource MetricValueStyle}" Margin="0,6,0,0" Text="{Binding Item.TrailText}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Padding="8" Margin="0,0,0,10" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="File" Margin="0,0,0,6" />
                        <TextBlock TextWrapping="Wrap">
                            <Hyperlink Click="OpenInFileExplorer_Click" ToolTip="{Binding Item.FilePath}">Open in File Explorer</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Padding="8" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Keyboard shortcuts" Margin="0,0,0,6" />
                        <TextBlock Text="Left / Right: previous or next frame" TextWrapping="Wrap" FontSize="11" />
                        <TextBlock Text="R: reject or unreject current frame" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0" />
                        <TextBlock Text="Mouse Wheel: zoom at cursor position" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0" />
                        <TextBlock Text="Ctrl + Drag: draw square ROI (1:1, release to confirm)" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0" />
                        <TextBlock Text="Escape: cancel ROI drag" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="4"
                Margin="0,10,0,0"
                Padding="8,4"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Foreground="Orange"
                           Text="{Binding PreviewStatusMessage}"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPreviewStatusVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Column="1"
                           Margin="12,0,0,0"
                           Foreground="#CCBDBDBD"
                           Text="{Binding CachedFrameCount, StringFormat=Cached: {0}}" />
            </Grid>
        </Border>
    </Grid>
</Window>