<Window x:Class="blink_o_mat.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Frame Preview" Height="900" Width="1300">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Smaller" Width="70" Margin="0,0,6,0" Click="Smaller_Click" />
                <Button Content="Fit" Width="60" Margin="0,0,6,0" Click="Fit_Click" />
                <Button Content="Zoom In" Width="70" Margin="0,0,6,0" Click="ZoomIn_Click" />
                <Button Content="1:1" Width="55" Margin="0,0,6,0" Click="OneToOne_Click" />
                <TextBlock VerticalAlignment="Center" Text="{Binding Zoom, StringFormat=Zoom: {0:F2}x}" />
            </StackPanel>

            <Border Grid.Row="1" BorderBrush="#22000000" BorderThickness="1" Background="#111111">
                <ScrollViewer x:Name="ImageScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="ImageScrollViewer_PreviewMouseWheel">
                    <Image x:Name="PreviewImage" Source="{Binding Image}" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                        </Image.LayoutTransform>
                    </Image>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel Grid.Column="1" Margin="12,0,0,0">
            <TextBlock FontWeight="SemiBold" FontSize="15" Text="{Binding Item.FileName}" TextWrapping="Wrap" Margin="0,0,0,12" />

            <TextBlock FontWeight="SemiBold" Text="Stretch" />
            <Slider Minimum="0.25" Maximum="5.0" Value="{Binding Stretch, UpdateSourceTrigger=PropertyChanged}" TickFrequency="0.05" IsSnapToTickEnabled="False" />
            <TextBlock Text="{Binding Stretch, StringFormat=F2}" Margin="0,0,0,12" />

            <TextBlock FontWeight="SemiBold" Text="Metrics" Margin="0,0,0,8" />
            <TextBlock Text="{Binding Item.Metrics.Fwhm, StringFormat=FWHM: {0:F2}}" />
            <TextBlock Text="{Binding Item.Metrics.FwhmArcsec, StringFormat=FWHM: {0:F2} arcsec, TargetNullValue=FWHM: n/a arcsec}" />
            <TextBlock Text="{Binding Item.Metrics.Hfr, StringFormat=HFR: {0:F2}}" />
            <TextBlock Text="{Binding Item.Metrics.StarCount, StringFormat=Stars: {0}}" />
            <TextBlock Text="{Binding Item.Metrics.Eccentricity, StringFormat=Eccentricity: {0:F3}}" />
            <TextBlock Text="{Binding Item.Metrics.MeanBackground, StringFormat=Mean BG: {0:F1}}" />
            <TextBlock Text="{Binding Item.Metrics.FocalLengthMm, StringFormat=Focal: {0:F1} mm, TargetNullValue=Focal: n/a}" />
            <TextBlock Text="{Binding Item.Metrics.PixelSizeUm, StringFormat=Pixel: {0:F2} µm, TargetNullValue=Pixel: n/a}" />
            <TextBlock Text="{Binding Item.Metrics.PossibleSatelliteTrail, StringFormat=Satellite trail: {0}}" Margin="0,0,0,12" />

            <CheckBox Content="Reject frame" IsChecked="{Binding Item.IsRejected, Mode=TwoWay}" />
        </StackPanel>
    </Grid>
</Window>
