<Window x:Class="blink_o_mat.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         Background="{StaticResource WindowBackgroundBrush}"
         Foreground="{StaticResource TextBrush}"
        Title="Frame Preview" Height="900" Width="1300">
    <Grid Margin="10" Background="{StaticResource WindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Prev" Width="60" Margin="0,0,6,0" Click="Prev_Click" />
                <Button Content="Next" Width="60" Margin="0,0,6,0" Click="Next_Click" />
                <Button Content="Smaller" Width="70" Margin="0,0,6,0" Click="Smaller_Click" />
                <Button Content="Fit" Width="60" Margin="0,0,6,0" Click="Fit_Click" />
                <Button Content="Zoom In" Width="70" Margin="0,0,6,0" Click="ZoomIn_Click" />
                <Button Content="1:1" Width="55" Margin="0,0,6,0" Click="OneToOne_Click" />
                <TextBlock VerticalAlignment="Center" Text="{Binding Zoom, StringFormat=Zoom: {0:F2}x}" />
            </StackPanel>

            <Border Grid.Row="1" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Background="#FF181818">
                <ScrollViewer x:Name="ImageScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="ImageScrollViewer_PreviewMouseWheel">
                    <Image x:Name="PreviewImage" Source="{Binding Image}" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality" MouseLeftButtonDown="PreviewImage_MouseLeftButtonDown">
                        <Image.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                        </Image.LayoutTransform>
                    </Image>
                </ScrollViewer>
            </Border>
        </Grid>

        <ScrollViewer Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Padding="10" Margin="0,0,0,10" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" FontSize="15" Text="{Binding Item.FileName}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Score:" FontWeight="SemiBold" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Item.OverallScoreStars}" Foreground="Gold" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Item.OverallScoreText}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Padding="10" Margin="0,0,0,10" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Inspection" Margin="0,0,0,6" />
                        <TextBlock FontWeight="SemiBold" Text="ROI bias" />
                        <ComboBox ItemsSource="{Binding RoiBiasOptions}" SelectedItem="{Binding RoiBias}" Margin="0,2,0,6" />
                        <TextBlock Text="Ctrl+Click image to set manual ROI override (persists for loaded set)." TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10" />
                        <CheckBox Content="Skip rejected when blinking" IsChecked="{Binding SkipRejectedInPreview, Mode=TwoWay}" Margin="0,0,0,10" />
                        <TextBlock FontWeight="SemiBold" Text="Stretch mode" />
                        <ComboBox ItemsSource="{Binding StretchModeOptions}" SelectedItem="{Binding StretchMode}" Margin="0,2,0,6" />
                        <TextBlock FontWeight="SemiBold" Text="Stretch" />
                        <Slider Minimum="0.25" Maximum="5.0" Value="{Binding Stretch, UpdateSourceTrigger=PropertyChanged}" TickFrequency="0.05" IsSnapToTickEnabled="False" />
                        <TextBlock Text="{Binding Stretch, StringFormat=F2}" Margin="0,0,0,8" />
                        <CheckBox Content="Use same target background for all frames" IsChecked="{Binding UseGlobalTargetBackground}" Margin="0,0,0,6" />
                        <TextBlock FontWeight="SemiBold" Text="Target background" />
                        <Slider Minimum="0.05" Maximum="0.75" Value="{Binding TargetBackground, UpdateSourceTrigger=PropertyChanged}" TickFrequency="0.01" IsSnapToTickEnabled="False" />
                        <TextBlock Text="{Binding TargetBackground, StringFormat=F2}" Margin="0,0,0,8" />
                        <CheckBox Content="Reject frame" IsChecked="{Binding Item.IsRejected, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <Border Padding="10" Margin="0,0,0,10" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Metrics" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{Binding Item.FwhmIndicatorBrush}" Margin="0,0,4,0" VerticalAlignment="Center" /><TextBlock Text="{Binding Item.Metrics.Fwhm, StringFormat=FWHM: {0:F2}}" /></StackPanel>
                        <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{Binding Item.FwhmIndicatorBrush}" Margin="0,0,4,0" VerticalAlignment="Center" /><TextBlock Text="{Binding Item.Metrics.FwhmArcsec, StringFormat=FWHM: {0:F2} arcsec, TargetNullValue=FWHM: n/a arcsec}" /></StackPanel>
                        <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{Binding Item.HfrIndicatorBrush}" Margin="0,0,4,0" VerticalAlignment="Center" /><TextBlock Text="{Binding Item.Metrics.Hfr, StringFormat=HFR: {0:F2}}" /></StackPanel>
                        <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{Binding Item.StarsIndicatorBrush}" Margin="0,0,4,0" VerticalAlignment="Center" /><TextBlock Text="{Binding Item.Metrics.StarCount, StringFormat=Stars: {0}}" /></StackPanel>
                        <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{Binding Item.EccentricityIndicatorBrush}" Margin="0,0,4,0" VerticalAlignment="Center" /><TextBlock Text="{Binding Item.Metrics.Eccentricity, StringFormat=Eccentricity: {0:F3}}" /></StackPanel>
                        <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{Binding Item.MeanBackgroundIndicatorBrush}" Margin="0,0,4,0" VerticalAlignment="Center" /><TextBlock Text="{Binding Item.Metrics.MeanBackground, StringFormat=Mean BG: {0:F1}}" /></StackPanel>
                        <TextBlock Text="{Binding Item.Metrics.FocalLengthMm, StringFormat=Focal: {0:F1} mm, TargetNullValue=Focal: n/a}" />
                        <TextBlock Text="{Binding Item.Metrics.PixelSizeUm, StringFormat=Pixel: {0:F2} µm, TargetNullValue=Pixel: n/a}" />
                        <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{Binding Item.TrailIndicatorBrush}" Margin="0,0,4,0" VerticalAlignment="Center" /><TextBlock Text="{Binding Item.Metrics.PossibleSatelliteTrail, StringFormat=Satellite trail: {0}}" /></StackPanel>
                    </StackPanel>
                </Border>

                <Border Padding="8" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Keyboard shortcuts" Margin="0,0,0,6" />
                        <TextBlock Text="Left / Right: previous or next frame" TextWrapping="Wrap" FontSize="11" />
                        <TextBlock Text="R: reject or unreject current frame" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0" />
                        <TextBlock Text="Ctrl + Mouse Wheel: zoom" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0" />
                        <TextBlock Text="Ctrl + Click: set manual ROI" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>






