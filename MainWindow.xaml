<Window x:Class="blink_o_mat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="blink-o-mat" Height="820" Width="1200">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" Text="Input folder:" />
            <TextBox Grid.Column="1" Margin="0,0,8,0" Text="{Binding InputFolder, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="2" Padding="10,3" Content="Browse" Command="{Binding BrowseInputCommand}" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" Text="Rejected folder:" />
            <TextBox Grid.Column="1" Margin="0,0,8,0" Text="{Binding RejectedFolder, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="2" Padding="10,3" Margin="0,0,8,0" Content="Browse" Command="{Binding BrowseRejectedCommand}" />
            <Button Grid.Column="3" Padding="12,3" Content="Load Frames" Command="{Binding LoadFramesCommand}" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsProgressVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <ProgressBar Height="16"
                         Minimum="0"
                         Maximum="{Binding ProgressMaximum, Mode=OneWay}"
                         Value="{Binding ProgressValue, Mode=OneWay}" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,26,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Stretch" />
                    <Slider Minimum="0.25" Maximum="3.0" Value="{Binding StretchStrength, UpdateSourceTrigger=PropertyChanged}" TickFrequency="0.05" IsSnapToTickEnabled="False" />
                    <TextBlock Margin="0,0,0,8" Text="{Binding StretchStrength, StringFormat=F2}" />

                    <TextBlock FontWeight="SemiBold" Margin="0,0,0,8" Text="Automatic rejection thresholds" />

                    <TextBlock Text="Max FWHM" />
                    <Slider Minimum="0" Maximum="15" Value="{Binding MaxFwhm, UpdateSourceTrigger=PropertyChanged}" TickFrequency="0.25" IsSnapToTickEnabled="False" />
                    <TextBlock Margin="0,0,0,8" Text="{Binding MaxFwhm, StringFormat=F2}" />

                    <TextBlock Text="Max HFR" />
                    <Slider Minimum="0" Maximum="10" Value="{Binding MaxHfr, UpdateSourceTrigger=PropertyChanged}" TickFrequency="0.1" IsSnapToTickEnabled="False" />
                    <TextBlock Margin="0,0,0,8" Text="{Binding MaxHfr, StringFormat=F2}" />

                    <TextBlock Text="Max Eccentricity" />
                    <Slider Minimum="0" Maximum="1" Value="{Binding MaxEccentricity, UpdateSourceTrigger=PropertyChanged}" TickFrequency="0.01" IsSnapToTickEnabled="False" />
                    <TextBlock Margin="0,0,0,8" Text="{Binding MaxEccentricity, StringFormat=F3}" />

                    <TextBlock Text="Max Mean Background" />
                    <Slider Minimum="0" Maximum="10000" Value="{Binding MaxMeanBackground, UpdateSourceTrigger=PropertyChanged}" TickFrequency="50" IsSnapToTickEnabled="False" />
                    <TextBlock Margin="0,0,0,8" Text="{Binding MaxMeanBackground, StringFormat=F1}" />

                    <CheckBox Content="Reject possible satellite trails" IsChecked="{Binding RejectSatelliteTrail}" Margin="0,6,0,12" />

                    <Button Padding="12,5" Content="One-click move rejected subframes" Command="{Binding MoveRejectedCommand}" />
                </StackPanel>
            </ScrollViewer>

            <ListView Grid.Column="1" ItemsSource="{Binding Frames}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#22000000" BorderThickness="1" Padding="6" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="340" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Border Width="160" Height="160" BorderBrush="#22000000" BorderThickness="1" Margin="0,0,6,0">
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.OpenPreviewCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" />
                                        </Border.InputBindings>
                                        <Image Stretch="Uniform" Source="{Binding ThumbnailImage}" ToolTip="Click to open preview" />
                                    </Border>
                                    <Border Width="160" Height="160" BorderBrush="#22000000" BorderThickness="1">
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.OpenPreviewCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" />
                                        </Border.InputBindings>
                                        <Image Stretch="UniformToFill" Source="{Binding RoiImage}" ToolTip="Click to open preview" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding FileName}" />
                                    <TextBlock Text="{Binding Metrics.Fwhm, StringFormat=FWHM: {0:F2}}" />
                                    <TextBlock Text="{Binding Metrics.Hfr, StringFormat=HFR: {0:F2}}" />
                                    <TextBlock Text="{Binding Metrics.Eccentricity, StringFormat=Eccentricity: {0:F3}}" />
                                    <TextBlock Text="{Binding Metrics.MeanBackground, StringFormat=Mean BG: {0:F1}}" />
                                    <TextBlock Text="{Binding Metrics.PossibleSatelliteTrail, StringFormat=Satellite trail: {0}}" />
                                </StackPanel>
                                <CheckBox Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0" IsChecked="{Binding IsRejected, Mode=TwoWay}" Content="Reject" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <StatusBar Grid.Row="3" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
