<Window x:Class="blink_o_mat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:controls="clr-namespace:blink_o_mat.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
         Background="{StaticResource WindowBackgroundBrush}"
         Foreground="{StaticResource TextBrush}"
        Title="Rejector" Height="1000" Width="1550" Icon="/6dd39f16-9f8b-454e-86c4-b44c409cb647.png">
    <Grid Margin="12" Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Hyperlink Command="{Binding BrowseInputCommand}" Foreground="{StaticResource TextBrush}">Input folder:</Hyperlink>
                </TextBlock>
                <TextBox Grid.Column="1" Text="{Binding InputFolder, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0" IsChecked="{Binding IncludeSubfolders}" ToolTip="Include subfolders recursively">Subfolders</CheckBox>
            </Grid>

            <Grid Grid.Column="1" Margin="0,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Hyperlink Command="{Binding BrowseRejectedCommand}" Foreground="{StaticResource TextBrush}">Rejected folder:</Hyperlink>
                </TextBlock>
                <TextBox Grid.Column="1" Text="{Binding RejectedFolder, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <Button Grid.Column="2" Padding="12,3" Content="Load Frames" Command="{Binding LoadFramesCommand}" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                <StackPanel>
                    <Border Padding="10" Margin="0,0,0,10" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Margin="0,0,0,6" Text="Session" />
                            <TextBlock Text="{Binding SessionFocalLengthMm, StringFormat=Focal: {0:F1} mm, TargetNullValue=Focal: n/a}" />
                            <TextBlock Text="{Binding SessionPixelSizeUm, StringFormat=Pixel: {0:F2} �m, TargetNullValue=Pixel: n/a}" />
                        </StackPanel>
                    </Border>

                    <Border Padding="10" Margin="0,0,0,10" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Margin="0,0,0,6" Text="Frame summary" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Total frames" />
                                <TextBlock Grid.Row="0" Grid.Column="1" FontWeight="SemiBold" Text="{Binding TotalFrameCount}" />
                                <TextBlock Grid.Row="1" Text="Rejected frames" Margin="0,4,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" FontWeight="SemiBold">
                                    <Run Text="{Binding RejectedFrameCount, Mode=OneWay}" />
                                    <Run Text=" (" />
                                    <Run Text="{Binding RejectedFramePercentageText, Mode=OneWay}" />
                                    <Run Text=")" />
                                </TextBlock>
                                <TextBlock Grid.Row="2" Text="Approved frames" Margin="0,4,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4,0,0" FontWeight="SemiBold">
                                    <Run Text="{Binding ApprovedFrameCount, Mode=OneWay}" />
                                    <Run Text=" (" />
                                    <Run Text="{Binding ApprovedFramePercentageText, Mode=OneWay}" />
                                    <Run Text=")" />
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Padding="10" Margin="0,0,0,10" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Margin="0,0,0,6" Text="Automatic rejection" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Min. trail confidence" />
                                <TextBlock Grid.Column="1" Opacity="0.78" Text="{Binding SatelliteTrailRejectedFrameCount, StringFormat={}Rejects: {0}}" />
                            </Grid>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" Width="56" HorizontalAlignment="Right" TextAlignment="Right" Text="{Binding MinSatelliteConfidence, StringFormat={}{0}%}" />
                                <Slider Minimum="1" Maximum="100" Value="{Binding MinSatelliteConfidence, UpdateSourceTrigger=PropertyChanged}"
                                        TickFrequency="5" IsSnapToTickEnabled="False" />
                            </DockPanel>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Max FWHM" />
                                <TextBlock Grid.Column="1" Opacity="0.78" Text="{Binding FwhmRejectedFrameCount, StringFormat={}Rejects: {0}}" />
                            </Grid>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" Width="56" HorizontalAlignment="Right" TextAlignment="Right" Text="{Binding MaxFwhm, StringFormat=F2}" />
                                <Slider Minimum="0" Maximum="15" Value="{Binding MaxFwhm, UpdateSourceTrigger=PropertyChanged}" TickFrequency="0.25" IsSnapToTickEnabled="False" />
                            </DockPanel>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Min SQM" />
                                <TextBlock Grid.Column="1" Opacity="0.78" Text="{Binding SqmRejectedFrameCount, StringFormat={}Rejects: {0}}" />
                            </Grid>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" Width="56" HorizontalAlignment="Right" TextAlignment="Right" Text="{Binding MinSqm, StringFormat=F2}" />
                                <Slider Minimum="0" Maximum="30" Value="{Binding MinSqm, UpdateSourceTrigger=PropertyChanged}" TickFrequency="0.05" IsSnapToTickEnabled="False" />
                            </DockPanel>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Max sky temp" />
                                <TextBlock Grid.Column="1" Opacity="0.78" Text="{Binding SkyTempRejectedFrameCount, StringFormat={}Rejects: {0}}" />
                            </Grid>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" Width="56" HorizontalAlignment="Right" TextAlignment="Right" Text="{Binding MaxSkyTemp, StringFormat=F1}" />
                                <Slider Minimum="-50" Maximum="50" Value="{Binding MaxSkyTemp, UpdateSourceTrigger=PropertyChanged}" TickFrequency="1" IsSnapToTickEnabled="False" />
                            </DockPanel>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Max HFR" />
                                <TextBlock Grid.Column="1" Opacity="0.78" Text="{Binding HfrRejectedFrameCount, StringFormat={}Rejects: {0}}" />
                            </Grid>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" Width="56" HorizontalAlignment="Right" TextAlignment="Right" Text="{Binding MaxHfr, StringFormat=F2}" />
                                <Slider Minimum="0" Maximum="10" Value="{Binding MaxHfr, UpdateSourceTrigger=PropertyChanged}" TickFrequency="0.1" IsSnapToTickEnabled="False" />
                            </DockPanel>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Max Eccentricity" />
                                <TextBlock Grid.Column="1" Opacity="0.78" Text="{Binding EccentricityRejectedFrameCount, StringFormat={}Rejects: {0}}" />
                            </Grid>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" Width="56" HorizontalAlignment="Right" TextAlignment="Right" Text="{Binding MaxEccentricity, StringFormat=F3}" />
                                <Slider Minimum="0" Maximum="1" Value="{Binding MaxEccentricity, UpdateSourceTrigger=PropertyChanged}" TickFrequency="0.01" IsSnapToTickEnabled="False" />
                            </DockPanel>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Max Mean Background" />
                                <TextBlock Grid.Column="1" Opacity="0.78" Text="{Binding MeanBackgroundRejectedFrameCount, StringFormat={}Rejects: {0}}" />
                            </Grid>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" Width="56" HorizontalAlignment="Right" TextAlignment="Right" Text="{Binding MaxMeanBackground, StringFormat=F1}" />
                                <Slider Minimum="0" Maximum="10000" Value="{Binding MaxMeanBackground, UpdateSourceTrigger=PropertyChanged}" TickFrequency="50" IsSnapToTickEnabled="False" />
                            </DockPanel>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Min Stars" />
                                <TextBlock Grid.Column="1" Opacity="0.78" Text="{Binding StarCountRejectedFrameCount, StringFormat={}Rejects: {0}}" />
                            </Grid>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Width="56" HorizontalAlignment="Right" TextAlignment="Right" Text="{Binding MinStars, StringFormat=F0}" />
                                <Slider Minimum="0" Maximum="1000" Value="{Binding MinStars, UpdateSourceTrigger=PropertyChanged}" TickFrequency="5" IsSnapToTickEnabled="False" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Padding="10" Margin="0,0,0,10" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                        <Expander IsExpanded="False">
                            <Expander.Header>
                                <TextBlock FontWeight="SemiBold" Text="Preview and ROI" />
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <CheckBox Content="Auto-stretch each frame individually" IsChecked="{Binding AutoStretchPerFrame}" Margin="0,0,0,8" />
                                <TextBlock FontWeight="SemiBold" Text="STF Target Background" Margin="0,0,0,2" />
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right"
                                               Text="{Binding StfTargetBackground, StringFormat=F2}" />
                                    <Slider Minimum="0.01" Maximum="0.5"
                                            Value="{Binding StfTargetBackground, UpdateSourceTrigger=PropertyChanged}"
                                            TickFrequency="0.01" IsSnapToTickEnabled="False" />
                                </DockPanel>
                                <TextBlock Text="ROI bias" />
                                <ComboBox ItemsSource="{Binding RoiBiasOptions}" SelectedItem="{Binding RoiBias}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Expander>
                    </Border>

                    <Border Padding="10" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Margin="0,0,0,8" Text="Actions" />
                            <Button Padding="12,5" Content="One-click move rejected subframes" Command="{Binding MoveRejectedCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- HEADER BAR -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- GROUP 1: Visibility (Accepted / Rejected) -->
                    <Border Grid.Column="0" Margin="0,0,8,0" Padding="8,4,8,6"
                            Background="#1A1A1A" BorderBrush="#333" BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="VISIBILITY" FontSize="9" FontWeight="Bold"
                                       Foreground="#666" Margin="0,0,0,4" />
                            <WrapPanel VerticalAlignment="Center">
                                <ToggleButton IsChecked="{Binding ShowAccepted, Mode=TwoWay}"
                                             Margin="0,0,6,0" Padding="12,4" BorderThickness="1" FontWeight="SemiBold">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Background" Value="#223A6B46" />
                                            <Setter Property="Foreground" Value="#FFE9F8EE" />
                                            <Setter Property="BorderBrush" Value="#5CA36E" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Background" Value="#2F3FAE63" />
                                                    <Setter Property="BorderBrush" Value="#7AD68E" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="False">
                                                    <Setter Property="Background" Value="#161616" />
                                                    <Setter Property="Foreground" Value="#CCBDBDBD" />
                                                    <Setter Property="BorderBrush" Value="#444" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                    <TextBlock Text="Accepted" />
                                </ToggleButton>

                                <ToggleButton IsChecked="{Binding ShowRejected, Mode=TwoWay}"
                                             Margin="0" Padding="12,4" BorderThickness="1" FontWeight="SemiBold">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Background" Value="#224E2A2A" />
                                            <Setter Property="Foreground" Value="#FFF9EAEA" />
                                            <Setter Property="BorderBrush" Value="#B85C5C" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Background" Value="#33C45F5F" />
                                                    <Setter Property="BorderBrush" Value="#E07A7A" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="False">
                                                    <Setter Property="Background" Value="#161616" />
                                                    <Setter Property="Foreground" Value="#CCBDBDBD" />
                                                    <Setter Property="BorderBrush" Value="#444" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                    <TextBlock Text="Rejected" />
                                </ToggleButton>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- GROUP 2: Filters (R, G, B, �) � only shown when chips exist -->
                    <Border Grid.Column="1" Margin="0,0,8,0" Padding="8,4,8,6"
                            Background="#1A1A1A" BorderBrush="#333" BorderThickness="1" CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasFilterChips}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="FILTERS" FontSize="9" FontWeight="Bold"
                                       Foreground="#666" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding FilterChips}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                     Margin="0,0,6,0" Padding="10,4" BorderThickness="1" FontWeight="SemiBold">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton">
                                                    <Setter Property="Background" Value="#222F426B" />
                                                    <Setter Property="Foreground" Value="#FFE8F0FF" />
                                                    <Setter Property="BorderBrush" Value="#6D88C4" />
                                                    <Setter Property="Cursor" Value="Hand" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter Property="Background" Value="#334F78D1" />
                                                            <Setter Property="BorderBrush" Value="#8FB3FF" />
                                                        </Trigger>
                                                        <Trigger Property="IsChecked" Value="False">
                                                            <Setter Property="Background" Value="#161616" />
                                                            <Setter Property="Foreground" Value="#CCBDBDBD" />
                                                            <Setter Property="BorderBrush" Value="#444" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- spacer -->
                    <Border Grid.Column="2" />

                    <!-- GROUP 3: Sort -->
                    <Border Grid.Column="3" Padding="8,4,8,6"
                            Background="#1A1A1A" BorderBrush="#333" BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="SORT" FontSize="9" FontWeight="Bold"
                                       Foreground="#666" Margin="0,0,0,4" />
                            <DockPanel LastChildFill="False">
                                <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding SortRules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <WrapPanel Margin="0,0,0,4">
                                                <!-- Field selector -->
                                                <ComboBox Height="26" Width="160" Margin="0,0,6,0"
                                                          ItemsSource="{Binding DataContext.SortFieldOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding SelectedField, Mode=TwoWay}"
                                                          DisplayMemberPath="DisplayName" />

                                                <!-- Asc / Desc toggle chip -->
                                                <ToggleButton IsChecked="{Binding IsDescending, Mode=TwoWay}"
                                                             Height="26" Width="32" Margin="0,0,6,0"
                                                             Padding="0" FontSize="14" ToolTip="Toggle sort direction">
                                                    <ToggleButton.Style>
                                                        <Style TargetType="ToggleButton">
                                                            <Setter Property="Background" Value="#161616" />
                                                            <Setter Property="Foreground" Value="#CCBDBDBD" />
                                                            <Setter Property="BorderBrush" Value="#444" />
                                                            <Setter Property="BorderThickness" Value="1" />
                                                            <Setter Property="Cursor" Value="Hand" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ToggleButton">
                                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                            <TextBlock x:Name="Arrow" Text="&#x25B2;" FontFamily="Segoe UI Symbol" FontSize="10"
                                                                                       Foreground="{TemplateBinding Foreground}"
                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsChecked" Value="True">
                                                                                <Setter TargetName="Arrow" Property="Text" Value="&#x25BC;" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter Property="Background" Value="#22426B9F" />
                                                                    <Setter Property="BorderBrush" Value="#6D88C4" />
                                                                    <Setter Property="Foreground" Value="#FFE8F0FF" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ToggleButton.Style>
                                                </ToggleButton>

                                                <!-- Remove rule -->
                                                <Button Height="26" Width="26" Padding="0"
                                                        FontWeight="SemiBold" FontSize="13"
                                                        Content="-" Margin="0"
                                                        Command="{Binding DataContext.RemoveSortRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </WrapPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Add rule -->
                                <Button DockPanel.Dock="Right" Height="26" Padding="10,0" Margin="8,0,0,0"
                                        Content="+ Field" Command="{Binding AddSortRuleCommand}"
                                        VerticalAlignment="Top" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <ListView Grid.Row="1"
                      x:Name="FramesListView"
                      ItemsSource="{Binding FilteredFrames}"
                      SelectedItem="{Binding SelectedFrame, Mode=TwoWay}"
                      SelectionChanged="FramesListView_SelectionChanged"
                      HorizontalContentAlignment="Stretch"
                      ScrollViewer.CanContentScroll="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      VirtualizingPanel.CacheLengthUnit="Item"
                      VirtualizingPanel.CacheLength="1">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <controls:FrameListItemView />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Margin="0,10,0,0" Padding="8,6" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />

                <ProgressBar Grid.Row="1"
                             Margin="0,6,0,0"
                             Height="12"
                             Minimum="0"
                             Maximum="{Binding ProgressMaximum, Mode=OneWay}"
                             Value="{Binding ProgressValue, Mode=OneWay}">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProgressVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </Grid>
        </Border>
    </Grid>
</Window>