<Window x:Class="blink_o_mat.RejectConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Rejection"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}">
    <StackPanel Margin="24,20,24,20">
        <TextBlock FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"
                   Text="Move rejected frames?" />

        <!-- Summary info card -->
        <Border Padding="12" Margin="0,0,0,12"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="{StaticResource MutedTextBrush}" Margin="0,0,10,0">Frames to move:</TextBlock>
                    <TextBlock Grid.Column="1" FontWeight="SemiBold" x:Name="FrameCountText" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="{StaticResource MutedTextBrush}" Margin="0,0,10,0">Destination:</TextBlock>
                    <TextBlock Grid.Column="1" x:Name="DestinationText" TextWrapping="Wrap" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Filter chip section — only shown when multiple filters exist -->
        <Border x:Name="FilterSection" Padding="12" Margin="0,0,0,12"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                           Margin="0,0,0,8"
                           Text="Select the filters to include in this move:" />
                <ItemsControl x:Name="FilterChipsList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton
                                Margin="0,0,6,6"
                                Padding="10,4"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                Content="{Binding Label}"
                                FontSize="12">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                        <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Background" Value="#55334422" />
                                                <Setter Property="BorderBrush" Value="#77AA7755" />
                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource TextBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,0,0,18"
                   TextWrapping="Wrap"
                   Text="Subfolder structure will be preserved. Files with conflicting names will be renamed automatically." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Padding="16,5" Margin="0,0,10,0" Click="Cancel_Click" IsCancel="True" />
            <Button x:Name="ProceedButton" Content="Proceed" Padding="16,5" Click="Proceed_Click" IsDefault="True"
                    Background="#99261414" BorderBrush="#C0392B" Foreground="#FFECACAC">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Background" Value="#99261414" />
                        <Setter Property="BorderBrush" Value="#C0392B" />
                        <Setter Property="Foreground" Value="#FFECACAC" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CC3D0C0C" />
                                <Setter Property="BorderBrush" Value="#E74C3C" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
