<UserControl
    x:Class="Rejector.Avalonia.Controls.MetricSliderControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Rejector.Avalonia.Controls"
    x:Name="Root">
  <UserControl.Styles>
    <Style Selector="Slider#TheSlider">
      <Setter Property="Height" Value="24" />
      <Setter Property="Margin" Value="0,1,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox#ValueEditor">
      <Setter Property="Background" Value="#252525" />
      <Setter Property="BorderBrush" Value="#569CD6" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Foreground" Value="#F0C060" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Right" />
      <Setter Property="Padding" Value="2,1" />
    </Style>
  </UserControl.Styles>

  <StackPanel Margin="0,0,0,8">
    <Grid ColumnDefinitions="*,72" ColumnSpacing="6" MinHeight="16">
      <TextBlock Grid.Column="0"
                 Text="{Binding Label, ElementName=Root}"
                 FontSize="12"
                 Foreground="#E2E6EA"
                 VerticalAlignment="Center" />
      <TextBlock Grid.Column="1"
                 FontSize="11"
                 Foreground="#D2D7DE"
                 HorizontalAlignment="Right"
                 TextAlignment="Right"
                 VerticalAlignment="Center"
                 Margin="0,0,2,0"
                 IsVisible="{Binding ShowRejectCount, ElementName=Root}"
                 Text="{Binding RejectCount, ElementName=Root, StringFormat=Rejects: {0}}" />
    </Grid>

    <Grid Margin="0,3,0,0" ColumnDefinitions="*,72" ColumnSpacing="6">
      <Slider Grid.Column="0"
              x:Name="TheSlider"
              Margin="0,0,1,0"
              Minimum="{Binding Minimum, ElementName=Root}"
              Maximum="{Binding Maximum, ElementName=Root}"
              TickFrequency="{Binding TickFrequency, ElementName=Root}"
              SmallChange="{Binding TickFrequency, ElementName=Root}"
              LargeChange="{Binding LargeChange, ElementName=Root}"
              Value="{Binding Value, ElementName=Root, Mode=TwoWay}">
        <Slider.Template>
          <ControlTemplate>
            <Grid Height="16" VerticalAlignment="Center" ClipToBounds="False">
              <Border Height="2"
                      VerticalAlignment="Center"
                      Margin="4,0"
                      Background="#8E949B"
                      CornerRadius="1" />
              <Track Name="PART_Track"
                     Margin="4,0"
                     Height="16"
                     VerticalAlignment="Center"
                     Minimum="{Binding Minimum, RelativeSource={RelativeSource TemplatedParent}}"
                     Maximum="{Binding Maximum, RelativeSource={RelativeSource TemplatedParent}}"
                     Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                     Orientation="{Binding Orientation, RelativeSource={RelativeSource TemplatedParent}}"
                     IsDirectionReversed="{Binding IsDirectionReversed, RelativeSource={RelativeSource TemplatedParent}}">
                <Track.DecreaseButton>
                  <RepeatButton IsTabStop="False"
                                Focusable="False"
                                Background="Transparent">
                    <RepeatButton.Template>
                      <ControlTemplate>
                        <Grid>
                          <Border Height="2"
                                  VerticalAlignment="Center"
                                  Background="#1E90FF"
                                  CornerRadius="1" />
                        </Grid>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseButton>
                <Track.IncreaseButton>
                  <RepeatButton IsTabStop="False"
                                Focusable="False"
                                Background="Transparent">
                    <RepeatButton.Template>
                      <ControlTemplate>
                        <Border Background="Transparent" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseButton>
                <Track.Thumb>
                  <Thumb Width="24"
                         Height="24"
                         MinWidth="24"
                         MinHeight="24"
                         VerticalAlignment="Center">
                    <Thumb.Template>
                      <ControlTemplate>
                        <Grid Width="14" Height="14" ClipToBounds="False">
                          <Border Width="8"
                                  Height="8"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Background="#1E90FF"
                                  BorderBrush="#0D6FC8"
                                  BorderThickness="1"
                                  CornerRadius="3" />
                        </Grid>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Slider.Template>
      </Slider>

      <Border Grid.Column="1"
              x:Name="ValueBorder"
              Width="72"
              Padding="4,0"
              Height="24"
              VerticalAlignment="Center"
              Background="#252525"
              BorderBrush="#569CD6"
              BorderThickness="0,0,0,1"
              Cursor="Ibeam"
              PointerPressed="ValueBorder_PointerPressed">
        <Grid>
          <TextBlock x:Name="ValueDisplay"
                     MinWidth="58"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="#F0C060"
                     Text="{Binding DisplayText, ElementName=Root}" />
          <TextBox x:Name="ValueEditor"
                   IsVisible="False"
                   VerticalAlignment="Center"
                   TextAlignment="Right"
                   LostFocus="ValueEditor_LostFocus"
                   KeyDown="ValueEditor_KeyDown" />
        </Grid>
      </Border>
    </Grid>
  </StackPanel>
</UserControl>
