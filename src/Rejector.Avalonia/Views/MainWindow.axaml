<Window
    x:Class="Rejector.Avalonia.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:Rejector.Avalonia.Controls"
    xmlns:vm="using:Rejector.Avalonia.ViewModels"
    x:DataType="vm:MainWindowViewModel"
    Icon="avares://Rejector.Avalonia/Assets/icon.ico"
    Background="{DynamicResource WindowBackgroundBrush}"
    Width="1550"
    Height="1000"
    MinWidth="1200"
    MinHeight="800"
    Title="{Binding Title}">
  <Window.Styles>
    <!-- Wider, always-visible, easier-to-grab scrollbar for the frame card list -->
    <Style Selector="ListBox.Cards ScrollBar:vertical">
      <Setter Property="Width" Value="18" />
      <Setter Property="Background" Value="#FF232629" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ListBox.Cards ScrollBar:vertical /template/ Thumb">
      <Setter Property="Background" Value="#FF6B7076" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Margin" Value="2,0" />
    </Style>
    <Style Selector="ListBox.Cards ScrollBar:vertical:pointerover /template/ Thumb">
      <Setter Property="Background" Value="#FF8A9096" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto" Margin="12" Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
        <ToggleButton Grid.Column="0"
                      Padding="10,8"
                      IsChecked="{Binding IsSettingsOpen}">
          <Path Width="14" Height="14" Stretch="Uniform" Fill="#FFFFFF" Data="M19.14,12.94A7.43,7.43 0 0,0 19.19,12A7.43,7.43 0 0,0 19.14,11.06L21.19,9.47C21.37,9.33 21.42,9.07 21.3,8.87L19.3,5.13C19.18,4.93 18.93,4.85 18.72,4.93L16.31,5.9C15.79,5.5 15.21,5.17 14.57,4.93L14.2,2.37C14.17,2.15 14,2 13.78,2H10.22C10,2 9.83,2.15 9.8,2.37L9.43,4.93C8.79,5.17 8.21,5.5 7.69,5.9L5.28,4.93C5.07,4.85 4.82,4.93 4.7,5.13L2.7,8.87C2.58,9.07 2.63,9.33 2.81,9.47L4.86,11.06C4.81,11.37 4.78,11.68 4.78,12C4.78,12.32 4.81,12.63 4.86,12.94L2.81,14.53C2.63,14.67 2.58,14.93 2.7,15.13L4.7,18.87C4.82,19.07 5.07,19.15 5.28,19.07L7.69,18.1C8.21,18.5 8.79,18.83 9.43,19.07L9.8,21.63C9.83,21.85 10,22 10.22,22H13.78C14,22 14.17,21.85 14.2,21.63L14.57,19.07C15.21,18.83 15.79,18.5 16.31,18.1L18.72,19.07C18.93,19.15 19.18,19.07 19.3,18.87L21.3,15.13C21.42,14.93 21.37,14.67 21.19,14.53L19.14,12.94M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5Z" />
        </ToggleButton>

        <Button Grid.Column="1" Padding="16,8" Background="#5D9A65" BorderBrush="#74B27C" Foreground="#FFFFFF" Click="OpenFolderPanel_Click">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Width="16" Height="16" Stretch="Uniform" Fill="#FFFFFF" Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" />
            <TextBlock Text="Open Folder" Foreground="#FFFFFF" />
          </StackPanel>
        </Button>

        <Button Grid.Column="2" Padding="10,8" Click="SaveSession_Click">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Width="14" Height="14" Stretch="Uniform" Fill="#FFFFFF" Data="M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3M19,19H5V5H16.17L19,7.83V19M12,12C10.34,12 9,13.34 9,15S10.34,18 12,18 15,16.66 15,15 13.66,12 12,12M6,6H15V10H6V6Z" />
            <TextBlock Text="Save" />
          </StackPanel>
        </Button>

        <Button Grid.Column="3" Padding="10,8" Click="LoadSession_Click">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Width="14" Height="14" Stretch="Uniform" Fill="#FFFFFF" Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20M12,11L16,15H13.5V19H10.5V15H8L12,11Z" />
            <TextBlock Text="Load" />
          </StackPanel>
        </Button>

        <Border Grid.Column="4" Margin="8,0,8,0" Padding="10,8" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="4">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock FontSize="11" Text="{Binding SessionFocalLengthText}" />
            <TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Text="|" />
            <TextBlock FontSize="11" Text="{Binding SessionPixelSizeText}" />
            <TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Text="|" />
            <TextBlock FontSize="11" Text="{Binding IncludeSubfoldersText}" />
          </StackPanel>
        </Border>

        <Border Grid.Column="5" />

        <Button Grid.Column="6" Padding="14,8" Background="#C0392B" BorderBrush="#E74C3C" Foreground="#FFFFFF" Click="RejectButton_Click">
          <TextBlock Text="Reject" Foreground="#FFFFFF" FontWeight="SemiBold" />
        </Button>
      </Grid>
    </Grid>

    <Grid Grid.Row="1" Margin="0,0,0,10" ColumnDefinitions="310,*">
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
        <StackPanel Spacing="10">
          <Border Padding="10" Margin="0,0,0,10" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="#FF27292C" BorderThickness="1">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Margin="0,0,0,6" Text="Frame summary" />
              <Grid Margin="0,0,0,4" ColumnDefinitions="*,Auto">
                <TextBlock Text="Total frames" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding TotalFrameCount}" FontSize="12" />
              </Grid>
              <ProgressBar Height="7" Minimum="0" Maximum="1" Value="{Binding OverallAcceptedRatio}" Foreground="#5CA36E" Background="#B85C5C" Margin="0,0,0,6" />
              <Grid Margin="0,0,0,2" ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="✓ " Foreground="#5CA36E" FontSize="12" />
                  <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Text="{Binding ApprovedFrameCount, StringFormat={}{0} accepted (}" />
                  <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Text="{Binding ApprovedFramePercentageText}" />
                  <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Text=")" />
                </StackPanel>
                <TextBlock Grid.Column="1" FontWeight="SemiBold" FontSize="12" Text="{Binding AcceptedIntegrationTimeText}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="✕ " Foreground="#B85C5C" FontSize="12" />
                  <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Text="{Binding RejectedFrameCount, StringFormat={}{0} rejected (}" />
                  <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Text="{Binding RejectedFramePercentageText}" />
                  <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Text=")" />
                </StackPanel>
                <TextBlock Grid.Column="1" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Text="{Binding TotalIntegrationTimeText, StringFormat=total: {0}}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding FilterSummaries}" Margin="0,8,0,0" IsVisible="{Binding HasMultipleFilterChips}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FilterSummaryViewModel">
                    <Grid Margin="0,3,0,0" Height="16" ColumnDefinitions="18,*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding FilterName}" FontSize="11" FontWeight="SemiBold" Foreground="#A8C4FF" VerticalAlignment="Center" />
                      <Grid Grid.Column="1" Margin="4,0,6,0">
                        <ProgressBar Height="16" Minimum="0" Maximum="1" Value="{Binding AcceptedRatio}" Foreground="#5CA36E" Background="#B85C5C" />
                        <Grid ColumnDefinitions="*,*">
                          <TextBlock Grid.Column="0" FontSize="10" Foreground="#F1F5FA" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0" Text="{Binding Accepted}" />
                          <TextBlock Grid.Column="1" FontSize="10" Foreground="#F1F5FA" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0" Text="{Binding Rejected}" />
                        </Grid>
                      </Grid>
                      <TextBlock Grid.Column="2" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Text="{Binding IntegrationTimeText}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Padding="10" Margin="0,0,0,10" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="#FF27292C" BorderThickness="1">
            <StackPanel>
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="0,0,0,8">
                <TextBlock Grid.Column="0" FontWeight="SemiBold" VerticalAlignment="Center" Text="Automatic rejection" />
                <Button Grid.Column="1" Content="↻" Width="26" Height="22" Command="{Binding ResetThresholdsCommand}" ToolTip.Tip="Set thresholds to the worst loaded frame values" />
                <ComboBox Grid.Column="2"
                          Width="110"
                          Height="22"
                          ItemsSource="{Binding RejectionFilterOptions}"
                          SelectedItem="{Binding SelectedRejectionFilter, Mode=TwoWay}" />
              </Grid>

              <controls:MetricSliderControl Label="Min. trail confidence"
                                            IsVisible="{Binding ShowTrailSlider}"
                                            Value="{Binding MinSatelliteConfidence}"
                                            Minimum="0"
                                            Maximum="100"
                                            TickFrequency="5"
                                            LargeChange="10"
                                            Decimals="0"
                                            Suffix="%"
                                            ShowRejectCount="True"
                                            RejectCount="{Binding SatelliteTrailRejectedFrameCount}" />
              <controls:MetricSliderControl Label="Min. cloud confidence"
                                            IsVisible="{Binding ShowCloudSlider}"
                                            Value="{Binding MinCloudConfidence}"
                                            Minimum="0"
                                            Maximum="100"
                                            TickFrequency="5"
                                            LargeChange="10"
                                            Decimals="0"
                                            Suffix="%"
                                            ShowRejectCount="True"
                                            RejectCount="{Binding CloudRejectedFrameCount}" />
              <controls:MetricSliderControl Label="Max FWHM (as)"
                                            IsVisible="{Binding ShowFwhmArcsecSlider}"
                                            Value="{Binding MaxFwhmArcsec}"
                                            Minimum="0"
                                            Maximum="30"
                                            TickFrequency="0.1"
                                            LargeChange="1"
                                            Decimals="2"
                                            ShowRejectCount="True"
                                            RejectCount="{Binding FwhmArcsecRejectedFrameCount}" />
              <controls:MetricSliderControl Label="Min SQM"
                                            IsVisible="{Binding ShowSqmSlider}"
                                            Value="{Binding MinSqm}"
                                            Minimum="0"
                                            Maximum="30"
                                            TickFrequency="0.05"
                                            LargeChange="1"
                                            Decimals="2"
                                            ShowRejectCount="True"
                                            RejectCount="{Binding SqmRejectedFrameCount}" />
              <controls:MetricSliderControl Label="Max sky temp"
                                            IsVisible="{Binding ShowSkyTempSlider}"
                                            Value="{Binding MaxSkyTemp}"
                                            Minimum="-50"
                                            Maximum="50"
                                            TickFrequency="1"
                                            LargeChange="5"
                                            Decimals="1"
                                            ShowRejectCount="True"
                                            RejectCount="{Binding SkyTempRejectedFrameCount}" />
              <controls:MetricSliderControl Label="Max HFR"
                                            IsVisible="{Binding ShowHfrSlider}"
                                            Value="{Binding MaxHfr}"
                                            Minimum="0"
                                            Maximum="10"
                                            TickFrequency="0.1"
                                            LargeChange="1"
                                            Decimals="2"
                                            ShowRejectCount="True"
                                            RejectCount="{Binding HfrRejectedFrameCount}" />
              <controls:MetricSliderControl Label="Max Eccentricity"
                                            IsVisible="{Binding ShowEccentricitySlider}"
                                            Value="{Binding MaxEccentricity}"
                                            Minimum="0"
                                            Maximum="1"
                                            TickFrequency="0.01"
                                            LargeChange="0.1"
                                            Decimals="3"
                                            ShowRejectCount="True"
                                            RejectCount="{Binding EccentricityRejectedFrameCount}" />
              <controls:MetricSliderControl Label="Max Mean Background"
                                            IsVisible="{Binding ShowMeanBackgroundSlider}"
                                            Value="{Binding MaxMeanBackground}"
                                            Minimum="0"
                                            Maximum="10000"
                                            TickFrequency="50"
                                            LargeChange="500"
                                            Decimals="1"
                                            ShowRejectCount="True"
                                            RejectCount="{Binding MeanBackgroundRejectedFrameCount}" />
              <controls:MetricSliderControl Label="Min Stars"
                                            IsVisible="{Binding ShowStarsSlider}"
                                            Value="{Binding MinStars}"
                                            Minimum="0"
                                            Maximum="20000"
                                            TickFrequency="50"
                                            LargeChange="500"
                                            Decimals="0"
                                            ShowRejectCount="True"
                                            RejectCount="{Binding StarCountRejectedFrameCount}" />
              <controls:MetricSliderControl Label="Min Score"
                                            IsVisible="{Binding ShowScoreSlider}"
                                            Value="{Binding MinScore}"
                                            Minimum="0"
                                            Maximum="5"
                                            TickFrequency="0.1"
                                            LargeChange="0.5"
                                            Decimals="1"
                                            ShowRejectCount="True"
                                            RejectCount="{Binding ScoreRejectedFrameCount}" />

              <CheckBox Content="Auto-stretch each frame individually"
                        IsChecked="{Binding AutoStretchPerFrame, Mode=TwoWay}"
                        Margin="0,6,0,2"
                        ToolTip.Tip="When enabled, STF is computed independently per frame" />
              <controls:MetricSliderControl Label="STF Target Background"
                                            Value="{Binding StfTargetBackground}"
                                            Minimum="0.01"
                                            Maximum="0.5"
                                            TickFrequency="0.01"
                                            LargeChange="0.05"
                                            Decimals="2" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8" ColumnDefinitions="Auto,Auto,*,Auto">
          <Border Grid.Column="0" Margin="0,0,8,0" Padding="8,4,8,6" BorderThickness="1" BorderBrush="{DynamicResource PanelBorderBrush}" CornerRadius="6" Background="{DynamicResource PanelBackgroundBrush}">
            <StackPanel>
              <TextBlock Text="VISIBILITY" FontSize="10" FontWeight="Bold" Foreground="#BCC5CF" Margin="0,0,0,4" />
              <WrapPanel>
                <ToggleButton Tag="accepted" IsChecked="{Binding ShowAccepted}" Margin="0,0,6,0" Height="30" Padding="12,0" BorderThickness="1" FontWeight="SemiBold" CornerRadius="12" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Loaded="ChipToggle_Loaded" Click="ChipToggle_Click">
                  <TextBlock Text="Accepted" />
                </ToggleButton>
                <ToggleButton Tag="rejected" IsChecked="{Binding ShowRejected}" Height="30" Padding="12,0" BorderThickness="1" FontWeight="SemiBold" CornerRadius="12" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Loaded="ChipToggle_Loaded" Click="ChipToggle_Click">
                  <TextBlock Text="Rejected" />
                </ToggleButton>
              </WrapPanel>
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Margin="0,0,8,0" Padding="8,4,8,6" BorderThickness="1" BorderBrush="{DynamicResource PanelBorderBrush}" CornerRadius="6" Background="{DynamicResource PanelBackgroundBrush}" IsVisible="{Binding HasFilterChips}">
            <StackPanel>
              <TextBlock Text="FILTERS" FontSize="10" FontWeight="Bold" Foreground="#BCC5CF" Margin="0,0,0,4" />
              <ItemsControl ItemsSource="{Binding FilterChips}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FilterChipViewModel">
                    <ToggleButton Tag="filter" IsChecked="{Binding IsSelected}" Margin="0,0,6,0" Height="30" Padding="10,0" BorderThickness="1" FontWeight="SemiBold" CornerRadius="12" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Left-click toggles this filter. Right-click shows only this filter." Loaded="ChipToggle_Loaded" Click="ChipToggle_Click" PointerPressed="FilterChip_PointerPressed">
                      <TextBlock Text="{Binding DisplayName}" />
                    </ToggleButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Grid.Column="3" Padding="8,4,8,6" BorderThickness="1" BorderBrush="{DynamicResource PanelBorderBrush}" CornerRadius="6" Background="{DynamicResource PanelBackgroundBrush}">
            <StackPanel>
              <TextBlock Text="SORT" FontSize="10" FontWeight="Bold" Foreground="#BCC5CF" Margin="0,0,0,4" />
              <ItemsControl ItemsSource="{Binding SortRules}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SortRuleViewModel">
                    <Grid ColumnDefinitions="140,92,Auto,Auto" ColumnSpacing="6" Margin="0,0,0,4">
                      <ComboBox Grid.Column="0" ItemsSource="{Binding $parent[Window].DataContext.SortFieldOptions}" SelectedItem="{Binding Field}" Width="136" />
                      <ToggleButton Grid.Column="1" IsChecked="{Binding IsAscending}" Content="{Binding DirectionLabel}" Width="88" />
                      <Button Grid.Column="2" Content="-" Width="32" Height="32" Command="{Binding $parent[Window].DataContext.RemoveSortRuleCommand}" CommandParameter="{Binding}" />
                      <Button Grid.Column="3" Content="+" Width="32" Height="32" IsVisible="{Binding IsLast}" Command="{Binding $parent[Window].DataContext.AddSortRuleCommand}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Grid>

        <ListBox Grid.Row="1" Classes="Cards" Background="Transparent" BorderThickness="0" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" ScrollViewer.VerticalScrollBarVisibility="Visible">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:FrameSummaryViewModel">
              <Border Margin="0,0,0,8" Padding="6" CornerRadius="4" Background="#FF3A3A3A" BorderBrush="#FF555555" BorderThickness="1" Tapped="ResultRow_Tapped">
                <Grid RowDefinitions="Auto,*" ColumnDefinitions="310,163*,521*,82*,150" ColumnSpacing="10">
                  <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,0,10,6">
                    <Border DockPanel.Dock="Right" Background="{Binding QualityBackgroundColor}" CornerRadius="5" Padding="10,3" VerticalAlignment="Center" Margin="12,0,0,0">
                      <TextBlock Text="{Binding QualityLabel}" Foreground="{Binding QualityColor}" FontWeight="Bold" FontSize="12" />
                    </Border>
                    <TextBlock DockPanel.Dock="Left" FontSize="20" FontWeight="SemiBold" Foreground="#F0F0F0" TextTrimming="CharacterEllipsis" Text="{Binding FileName}" ToolTip.Tip="{Binding FileName}" VerticalAlignment="Center" />
                  </DockPanel>

                  <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="150,150">
                    <Border Grid.Column="0" Width="145" Height="145" Margin="0,0,6,0" BorderBrush="#3B3E42" BorderThickness="1" Background="#151618" CornerRadius="4" ClipToBounds="True">
                      <Grid>
                        <Image Stretch="UniformToFill" Source="{Binding Thumbnail}" />
                        <Border Background="#AA1C1C1C" CornerRadius="3" Padding="5,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                          <TextBlock Text="Frame" FontSize="11" FontWeight="SemiBold" Foreground="#EEEEEE" />
                        </Border>
                      </Grid>
                    </Border>
                    <Border Grid.Column="1" Width="145" Height="145" BorderBrush="#3B3E42" BorderThickness="1" Background="#151618" CornerRadius="4" ClipToBounds="True">
                      <Grid>
                        <Image Stretch="UniformToFill" Source="{Binding RoiImage}" />
                        <Border Background="#AA1C1C1C" CornerRadius="3" Padding="5,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                          <TextBlock Text="ROI" FontSize="11" FontWeight="SemiBold" Foreground="#EEEEEE" />
                        </Border>
                      </Grid>
                    </Border>
                  </Grid>

                  <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" RowDefinitions="Auto,Auto,*">
                    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                      <TextBlock Text="{Binding TimestampDisplay}" Foreground="#BBBBBB" FontSize="12" Margin="0,0,12,0" />
                      <TextBlock Text="•" Foreground="#666666" Margin="0,0,12,0" />
                      <TextBlock Text="{Binding ExposureDisplay}" Foreground="#BBBBBB" FontSize="12" Margin="0,0,12,0" />
                      <TextBlock Text="•" Foreground="#666666" Margin="0,0,12,0" />
                      <TextBlock Text="Filter: " Foreground="#888888" FontSize="12" />
                      <Border Width="9" Height="9" CornerRadius="5" VerticalAlignment="Center" Margin="0,0,5,0" Background="{Binding FilterIndicatorColor}" />
                      <TextBlock Text="{Binding FilterDisplay}" Foreground="#BBBBBB" FontSize="12" Margin="0,0,12,0" />
                    </WrapPanel>

                    <WrapPanel Grid.Row="1">
                      <Border Background="#202224" BorderBrush="{Binding FwhmIndicatorColor}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,8" IsVisible="{Binding $parent[Window].DataContext.ShowFwhmArcsecMetric}">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="FWHM" Foreground="#A0A0A0" FontSize="11" Margin="0,0,6,0" />
                          <TextBlock Text="{Binding FwhmArcsecDisplay}" Foreground="{Binding FwhmIndicatorColor}" FontWeight="SemiBold" />
                        </StackPanel>
                      </Border>
                      <Border Background="#202224" BorderBrush="{Binding EccentricityIndicatorColor}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,8" IsVisible="{Binding $parent[Window].DataContext.ShowEccentricityMetric}">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="ECC" Foreground="#A0A0A0" FontSize="11" Margin="0,0,6,0" />
                          <TextBlock Text="{Binding EccentricityDisplay}" Foreground="{Binding EccentricityIndicatorColor}" FontWeight="SemiBold" />
                        </StackPanel>
                      </Border>
                      <Border Background="#202224" BorderBrush="{Binding HfrIndicatorColor}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,8" IsVisible="{Binding $parent[Window].DataContext.ShowHfrMetric}">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="HFR" Foreground="#A0A0A0" FontSize="11" Margin="0,0,6,0" />
                          <TextBlock Text="{Binding HfrDisplay}" Foreground="{Binding HfrIndicatorColor}" FontWeight="SemiBold" />
                        </StackPanel>
                      </Border>
                      <Border Background="#202224" BorderBrush="{Binding StarsIndicatorColor}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,8" IsVisible="{Binding $parent[Window].DataContext.ShowStarsMetric}">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="STARS" Foreground="#A0A0A0" FontSize="11" Margin="0,0,6,0" />
                          <TextBlock Text="{Binding StarCount}" Foreground="{Binding StarsIndicatorColor}" FontWeight="SemiBold" />
                        </StackPanel>
                      </Border>
                      <Border Background="#202224" BorderBrush="{Binding TrailIndicatorColor}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,8" IsVisible="{Binding $parent[Window].DataContext.ShowTrailMetric}">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="TRAIL" Foreground="#A0A0A0" FontSize="11" Margin="0,0,6,0" />
                          <TextBlock Text="{Binding TrailText}" Foreground="{Binding TrailIndicatorColor}" FontWeight="SemiBold" />
                        </StackPanel>
                      </Border>
                      <Border Background="#202224" BorderBrush="{Binding CloudIndicatorColor}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,8" IsVisible="{Binding $parent[Window].DataContext.ShowCloudMetric}">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="CLOUD" Foreground="#A0A0A0" FontSize="11" Margin="0,0,6,0" />
                          <TextBlock Text="{Binding CloudText}" Foreground="{Binding CloudIndicatorColor}" FontWeight="SemiBold" />
                        </StackPanel>
                      </Border>
                      <Border Background="#202224" BorderBrush="#4C9AFF" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,8" IsVisible="{Binding $parent[Window].DataContext.ShowSqmMetric}">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="SQM" Foreground="#A0A0A0" FontSize="11" Margin="0,0,6,0" />
                          <TextBlock Text="{Binding SqmDisplay}" Foreground="#DDEBFF" FontWeight="SemiBold" />
                        </StackPanel>
                      </Border>
                    </WrapPanel>

                    <Grid Grid.Row="2" Margin="0,4,0,0" ColumnDefinitions="*,14,*,14,*">
                      <Border Grid.Column="0" BorderBrush="#2E3134" BorderThickness="0,0,1,0" Padding="0,4,8,0">
                        <StackPanel>
                          <TextBlock Text="OPTICS" FontSize="11" FontWeight="SemiBold" Foreground="#7AA7FF" Margin="0,0,0,6" />
                          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                            <TextBlock Text="FWHM (px)" FontSize="12" Foreground="#D0D0D0" Margin="0,0,0,2" IsVisible="{Binding $parent[Window].DataContext.ShowFwhmMetric}" />
                            <TextBlock Grid.Column="1" Text="{Binding FwhmPixelDisplay}" FontSize="12" Foreground="#F2F2F2" Margin="12,0,0,2" IsVisible="{Binding $parent[Window].DataContext.ShowFwhmMetric}" />
                            <TextBlock Grid.Row="1" Text="FWHM (arcsec)" FontSize="12" Foreground="#D0D0D0" Margin="0,0,0,2" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FwhmArcsecDisplay}" FontSize="12" Foreground="#F2F2F2" Margin="12,0,0,2" />
                            <TextBlock Grid.Row="2" Text="HFR" FontSize="12" Foreground="#D0D0D0" Margin="0,0,0,2" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding HfrDisplay}" FontSize="12" Foreground="#F2F2F2" Margin="12,0,0,2" />
                            <TextBlock Grid.Row="3" Text="Eccentricity" FontSize="12" Foreground="#D0D0D0" Margin="0,0,0,2" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding EccentricityDisplay}" FontSize="12" Foreground="#F2F2F2" Margin="12,0,0,2" />
                          </Grid>
                        </StackPanel>
                      </Border>

                      <Border Grid.Column="2" BorderBrush="#2E3134" BorderThickness="0,0,1,0" Padding="0,4,8,0">
                        <StackPanel>
                          <TextBlock Text="BACKGROUND" FontSize="11" FontWeight="SemiBold" Foreground="#7AA7FF" Margin="0,0,0,6" />
                          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                            <TextBlock Text="Mean BG" FontSize="12" Foreground="#D0D0D0" Margin="0,0,0,2" IsVisible="{Binding $parent[Window].DataContext.ShowMeanBackgroundMetric}" />
                            <TextBlock Grid.Column="1" Text="{Binding MeanBackgroundDisplay}" FontSize="12" Foreground="#F2F2F2" Margin="12,0,0,2" IsVisible="{Binding $parent[Window].DataContext.ShowMeanBackgroundMetric}" />
                            <TextBlock Grid.Row="1" Text="Median" FontSize="12" Foreground="#D0D0D0" Margin="0,0,0,2" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MedianDisplay}" FontSize="12" Foreground="#F2F2F2" Margin="12,0,0,2" />
                            <TextBlock Grid.Row="2" Text="MAD" FontSize="12" Foreground="#D0D0D0" Margin="0,0,0,2" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MadDisplay}" FontSize="12" Foreground="#F2F2F2" Margin="12,0,0,2" />
                            <TextBlock Grid.Row="3" Text="SQM" FontSize="12" Foreground="#D0D0D0" Margin="0,0,0,2" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SqmDisplay}" FontSize="12" Foreground="#F2F2F2" Margin="12,0,0,2" />
                          </Grid>
                        </StackPanel>
                      </Border>

                      <StackPanel Grid.Column="4" Margin="0,4,0,0">
                        <TextBlock Text="FRAME" FontSize="11" FontWeight="SemiBold" Foreground="#7AA7FF" Margin="0,0,0,6" />
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                          <TextBlock Text="Stars" FontSize="12" Foreground="#D0D0D0" Margin="0,0,0,2" IsVisible="{Binding $parent[Window].DataContext.ShowStarsMetric}" />
                          <TextBlock Grid.Column="1" Text="{Binding StarCount}" FontSize="12" Foreground="#F2F2F2" Margin="12,0,0,2" IsVisible="{Binding $parent[Window].DataContext.ShowStarsMetric}" />
                          <TextBlock Grid.Row="1" Text="Sky temp" FontSize="12" Foreground="#D0D0D0" Margin="0,0,0,2" IsVisible="{Binding $parent[Window].DataContext.ShowSkyTempMetric}" />
                          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SkyTempDisplay}" FontSize="12" Foreground="#F2F2F2" Margin="12,0,0,2" IsVisible="{Binding $parent[Window].DataContext.ShowSkyTempMetric}" />
                          <TextBlock Grid.Row="2" Text="Min / count" FontSize="12" Foreground="#D0D0D0" Margin="0,0,0,2" />
                          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MinDisplay}" FontSize="12" Foreground="#F2F2F2" Margin="12,0,0,2" />
                          <TextBlock Grid.Row="3" Text="Max / count" FontSize="12" Foreground="#D0D0D0" Margin="0,0,0,2" />
                          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MaxDisplay}" FontSize="12" Foreground="#F2F2F2" Margin="12,0,0,2" />
                        </Grid>
                      </StackPanel>
                    </Grid>
                  </Grid>

                  <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="4" Background="#1B1D20" BorderBrush="#303338" BorderThickness="1" CornerRadius="4" Padding="12,10" ClipToBounds="True" IsVisible="{Binding $parent[Window].DataContext.ShowScoreMetric}">
                    <StackPanel>
                      <TextBlock Text="SCORE" FontSize="11" Foreground="#9A9A9A" />
                      <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                        <TextBlock Text="{Binding ScoreValueText}" FontSize="34" FontWeight="Bold" Foreground="{Binding QualityColor}" />
                        <TextBlock Text=" / 5" FontSize="16" Foreground="#C8C8C8" VerticalAlignment="Bottom" Margin="4,0,0,4" />
                      </StackPanel>
                      <Border Margin="0,10,0,14" Height="12" Background="#303338" CornerRadius="3" ClipToBounds="True">
                        <ProgressBar Height="12" Minimum="0" Maximum="100" Value="{Binding ScoreProgressPercent}" Foreground="{Binding QualityColor}" Background="#303338" HorizontalAlignment="Stretch" />
                      </Border>
                      <Button Command="{Binding ToggleRejectCommand}" CommandParameter="{Binding}" FontWeight="SemiBold" Foreground="#F5F5F5" HorizontalContentAlignment="Center" HorizontalAlignment="Stretch" Height="34" MinHeight="34" Padding="10,7" BorderThickness="0" Background="{Binding RejectionStateColor}">
                        <TextBlock Text="{Binding RejectionStateLabel}" FontWeight="SemiBold" Foreground="#F5F5F5" HorizontalAlignment="Center" />
                      </Button>
                      <Grid Margin="0,6,0,0" Height="22" ColumnDefinitions="*,Auto,*">
                        <Viewbox Grid.Column="0" Width="28" Height="22" HorizontalAlignment="Left" IsVisible="{Binding HasCloudDetection}" ToolTip.Tip="Cloud detection">
                          <Path Data="M6,17H18A4,4 0,0 0,18.7,9.06A5.5,5.5 0,0 0,8.33,10.44A3.5,3.5 0,0 0,6,17M4,20H20"
                                Stroke="{Binding CloudIndicatorColor}"
                                StrokeThickness="2.2"
                                StrokeLineCap="Round"
                                StrokeJoin="Round"
                                Fill="Transparent" />
                        </Viewbox>
                        <Border Grid.Column="1" HorizontalAlignment="Center" IsVisible="{Binding HasRejectionReasons}">
                          <Border Background="#2A2D31" BorderBrush="#FF6B6B" BorderThickness="1" CornerRadius="10" Width="20" Height="20">
                            <ToolTip.Tip>
                              <StackPanel>
                                <TextBlock Text="REJECTION REASONS" FontSize="10" FontWeight="Bold" Foreground="#FF9A9A" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding RejectionReasons}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                      <DockPanel Margin="0,3,0,0">
                                        <TextBlock Text="▸" Foreground="#FF6B6B" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding}" Foreground="#F0F0F0" FontSize="12" TextWrapping="Wrap" />
                                      </DockPanel>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </ToolTip.Tip>
                            <TextBlock Text="?" FontSize="11" FontWeight="Bold" Foreground="#FF9A9A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                        </Border>
                        <Viewbox Grid.Column="2" Width="28" Height="22" HorizontalAlignment="Right" IsVisible="{Binding HasSatelliteTrailDetection}" ToolTip.Tip="Satellite trail detection">
                          <Path Data="M9,8L13,12M11,6L15,10M6,11L10,15M14,5L19,10M16,3L21,8M12,11L17,16M18,17L21,20M3,18L8,13"
                                Stroke="{Binding TrailIndicatorColor}"
                                StrokeThickness="2.2"
                                StrokeLineCap="Round"
                                StrokeJoin="Round"
                                Fill="Transparent" />
                        </Viewbox>
                      </Grid>
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Grid>

    <Border Grid.Row="1" Width="440" MaxHeight="680" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,10" Padding="14" Background="#DD1A1C1F" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="6" IsVisible="{Binding IsFolderPanelOpen}" ZIndex="51">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Open Folder" FontSize="18" FontWeight="SemiBold" />
          <Button Grid.Column="1" Padding="8,4" Click="CloseFolderPanel_Click" Content="Close" />
        </Grid>
        <TextBlock Text="Input Folder" FontSize="11" FontWeight="SemiBold" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
          <TextBox Text="{Binding InputFolder}" MinHeight="30" ToolTip.Tip="Path to the folder containing raw FITS/XISF frames" />
          <Button Grid.Column="1" Width="34" Height="30" Click="BrowseFolder_Click" Content="..." />
        </Grid>

        <Border Background="#18212732" BorderBrush="#2F3D54" BorderThickness="1" CornerRadius="4" Padding="8,6">
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
            <TextBlock Text="Setting" FontWeight="SemiBold" FontSize="11" Foreground="#B9C7DB" />
            <TextBlock Grid.Column="1" Text="Enabled" FontWeight="SemiBold" FontSize="11" Foreground="#B9C7DB" HorizontalAlignment="Center" />

            <TextBlock Grid.Row="1" Text="Include subfolders" VerticalAlignment="Center" FontSize="11" ToolTip.Tip="Include subfolders recursively" />
            <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding IncludeSubfolders}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="Include subfolders recursively" />

            <TextBlock Grid.Row="2" Text="Watch folder" VerticalAlignment="Center" FontSize="11" ToolTip.Tip="Automatically reload frames when FITS/XISF files are added, removed, or renamed" />
            <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding WatchFolderEnabled}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="Automatically reload frames when FITS/XISF files are added, removed, or renamed" />
          </Grid>
        </Border>

        <TextBlock Text="Rejected Folder" FontSize="11" FontWeight="SemiBold" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
          <TextBox Text="{Binding RejectedFolder}" MinHeight="30" ToolTip.Tip="Destination folder for rejected frames" />
          <Button Grid.Column="1" Width="34" Height="30" Click="BrowseRejectedFolder_Click" Content="..." />
        </Grid>
        <Button HorizontalAlignment="Stretch" Background="#5D9A65" BorderBrush="#74B27C" Foreground="#FFFFFF" Command="{Binding AnalyzeCommand}" Content="{Binding AnalyzeButtonText}">
          <ToolTip.Tip>
            <TextBlock Text="{Binding AnalyzeButtonText}" />
          </ToolTip.Tip>
        </Button>
      </StackPanel>
      </ScrollViewer>
    </Border>

    <Border Grid.Row="1" Margin="0,0,0,10" Padding="14" Background="#DD1A1C1F" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="6" IsVisible="{Binding IsSettingsOpen}" ZIndex="50">
      <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" />
          <Button Grid.Column="1" Padding="8,4" Click="CloseSettings_Click" Content="Close" />
        </Grid>
        <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="10">
          <Border Background="#1A2A3F5F" BorderBrush="#4C7FB2" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,0,4">
            <TextBlock Text="PROFILES" FontSize="13" FontWeight="Bold" Foreground="#D7E8FF" />
          </Border>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,8">
            <TextBox PlaceholderText="Profile name" Text="{Binding NewProfileName, Mode=TwoWay}" />
            <Button Grid.Column="1" Content="Create" Command="{Binding CreateProfileCommand}" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,8">
            <ComboBox ItemsSource="{Binding SettingsProfiles}" SelectedItem="{Binding SelectedSettingsProfile, Mode=TwoWay}" DisplayMemberBinding="{Binding Name}" />
            <CheckBox Grid.Column="1" Content="Default" IsChecked="{Binding IsSelectedProfileDefault, Mode=TwoWay}" VerticalAlignment="Center" />
          </Grid>

          <Border Background="#1A2A3F5F" BorderBrush="#4C7FB2" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,8,0,0">
            <TextBlock Text="STRETCH" FontSize="13" FontWeight="Bold" Foreground="#D7E8FF" />
          </Border>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" RowDefinitions="Auto" RowSpacing="8">
            <TextBlock VerticalAlignment="Center" Text="STF target background" />
            <NumericUpDown Grid.Column="1" Minimum="0.01" Maximum="0.50" Increment="0.01" Value="{Binding StfTargetBackground}" FormatString="F2" />
          </Grid>

          <Border Background="#1A2A3F5F" BorderBrush="#4C7FB2" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,8,0,0">
            <TextBlock Text="PREVIEW OVERLAYS" FontSize="13" FontWeight="Bold" Foreground="#D7E8FF" />
          </Border>
          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
            <CheckBox Content="ROI overlay" IsChecked="{Binding IsRoiOverlayVisible}" />
            <CheckBox Grid.Column="1" Content="Star debug" IsChecked="{Binding IsStarDebugOverlayVisible}" />
            <CheckBox Grid.Row="1" Content="Orientation debug" IsChecked="{Binding IsOrientationDebugOverlayVisible}" />
            <CheckBox Grid.Row="1" Grid.Column="1" Content="Curvature view" IsChecked="{Binding IsCurvatureViewVisible}" />
          </Grid>

          <Border Background="#1A2A3F5F" BorderBrush="#4C7FB2" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,8,0,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock Text="METRIC SETTINGS" FontSize="13" FontWeight="Bold" Foreground="#D7E8FF" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="Reset score defaults" Padding="10,2" Click="ResetScoreWeightsButton_Click" />
            </Grid>
          </Border>
          <Grid ColumnDefinitions="180,150,280,250" RowDefinitions="28,36,36,36,36,36,36,36,36,36,36,36" ColumnSpacing="8" RowSpacing="4">
            <TextBlock Text="Metric" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Visibility (slider / metric)" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="Thresholds (auto / value)" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="Score (use / weight)" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />

            <TextBlock Grid.Row="1" Text="Trail confidence" VerticalAlignment="Center" /><StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="12"><CheckBox IsChecked="{Binding ShowTrailSlider}" /><CheckBox IsChecked="{Binding ShowTrailMetric}" /></StackPanel><StackPanel Grid.Row="1" Grid.Column="2" IsVisible="{Binding IsTrailThresholdSettingVisible}" Orientation="Horizontal" Spacing="10"><CheckBox IsChecked="{Binding AutoCalcTrailThreshold}" /><NumericUpDown IsVisible="{Binding AutoCalcTrailThreshold, Converter={StaticResource InverseBooleanConverter}}" Width="190" Minimum="0" Maximum="100" Increment="1" Value="{Binding MinSatelliteConfidence}" FormatString="F0" /></StackPanel><StackPanel Grid.Row="1" Grid.Column="3" IsVisible="{Binding IsTrailScoreSettingVisible}" Orientation="Horizontal" Spacing="10"><CheckBox IsChecked="{Binding UseScoreTrail}" /><NumericUpDown IsVisible="{Binding UseScoreTrail}" Width="180" Minimum="0" Maximum="5" Increment="0.1" Value="{Binding ScoreWeightTrail}" FormatString="F1" /></StackPanel>
            <TextBlock Grid.Row="2" Text="Cloud confidence" VerticalAlignment="Center" /><StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="12"><CheckBox IsChecked="{Binding ShowCloudSlider}" /><CheckBox IsChecked="{Binding ShowCloudMetric}" /></StackPanel><StackPanel Grid.Row="2" Grid.Column="2" IsVisible="{Binding IsCloudThresholdSettingVisible}" Orientation="Horizontal" Spacing="10"><CheckBox IsChecked="{Binding AutoCalcCloudThreshold}" /><NumericUpDown IsVisible="{Binding AutoCalcCloudThreshold, Converter={StaticResource InverseBooleanConverter}}" Width="190" Minimum="0" Maximum="100" Increment="1" Value="{Binding MinCloudConfidence}" FormatString="F0" /></StackPanel><StackPanel Grid.Row="2" Grid.Column="3" IsVisible="{Binding IsCloudScoreSettingVisible}" Orientation="Horizontal" Spacing="10"><CheckBox IsChecked="{Binding UseScoreCloud}" /><NumericUpDown IsVisible="{Binding UseScoreCloud}" Width="180" Minimum="0" Maximum="5" Increment="0.1" Value="{Binding ScoreWeightCloud}" FormatString="F1" /></StackPanel>
            <TextBlock Grid.Row="3" Text="FWHM (px)" VerticalAlignment="Center" /><StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="12"><CheckBox IsChecked="{Binding ShowFwhmSlider}" /><CheckBox IsChecked="{Binding ShowFwhmMetric}" /></StackPanel><StackPanel Grid.Row="3" Grid.Column="2" IsVisible="{Binding IsFwhmThresholdSettingVisible}" Orientation="Horizontal" Spacing="10"><CheckBox IsChecked="{Binding AutoCalcFwhmThreshold}" /><NumericUpDown IsVisible="{Binding AutoCalcFwhmThreshold, Converter={StaticResource InverseBooleanConverter}}" Width="190" Minimum="0" Maximum="50" Increment="0.1" Value="{Binding MaxFwhm}" FormatString="F2" /></StackPanel><StackPanel Grid.Row="3" Grid.Column="3" IsVisible="{Binding IsFwhmScoreSettingVisible}" Orientation="Horizontal" Spacing="10"><CheckBox IsChecked="{Binding UseScoreFwhm}" /><NumericUpDown IsVisible="{Binding UseScoreFwhm}" Width="180" Minimum="0" Maximum="5" Increment="0.1" Value="{Binding ScoreWeightFwhm}" FormatString="F1" /></StackPanel>
            <TextBlock Grid.Row="4" Text="FWHM (arcsec)" VerticalAlignment="Center" /><StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="12"><CheckBox IsChecked="{Binding ShowFwhmArcsecSlider}" /><CheckBox IsChecked="{Binding ShowFwhmArcsecMetric}" /></StackPanel><StackPanel Grid.Row="4" Grid.Column="2" Orientation="Horizontal" Spacing="10"><CheckBox IsChecked="{Binding AutoCalcFwhmArcsecThreshold}" /><NumericUpDown IsVisible="{Binding AutoCalcFwhmArcsecThreshold, Converter={StaticResource InverseBooleanConverter}}" Width="190" Minimum="0" Maximum="30" Increment="0.1" Value="{Binding MaxFwhmArcsec}" FormatString="F2" /></StackPanel><TextBlock Grid.Row="4" Grid.Column="3" Text="-" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="5" Text="SQM" VerticalAlignment="Center" /><StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="12"><CheckBox IsChecked="{Binding ShowSqmSlider}" /><CheckBox IsChecked="{Binding ShowSqmMetric}" /></StackPanel><StackPanel Grid.Row="5" Grid.Column="2" Orientation="Horizontal" Spacing="10"><CheckBox IsChecked="{Binding AutoCalcSqmThreshold}" /><NumericUpDown IsVisible="{Binding AutoCalcSqmThreshold, Converter={StaticResource InverseBooleanConverter}}" Width="190" Minimum="0" Maximum="30" Increment="0.05" Value="{Binding MinSqm}" FormatString="F2" /></StackPanel><TextBlock Grid.Row="5" Grid.Column="3" Text="-" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="6" Text="Sky temp" VerticalAlignment="Center" /><StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Spacing="12"><CheckBox IsChecked="{Binding ShowSkyTempSlider}" /><CheckBox IsChecked="{Binding ShowSkyTempMetric}" /></StackPanel><StackPanel Grid.Row="6" Grid.Column="2" Orientation="Horizontal" Spacing="10"><CheckBox IsChecked="{Binding AutoCalcSkyTempThreshold}" /><NumericUpDown IsVisible="{Binding AutoCalcSkyTempThreshold, Converter={StaticResource InverseBooleanConverter}}" Width="190" Minimum="-50" Maximum="50" Increment="1" Value="{Binding MaxSkyTemp}" FormatString="F1" /></StackPanel><TextBlock Grid.Row="6" Grid.Column="3" Text="-" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="7" Text="HFR" VerticalAlignment="Center" /><StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Spacing="12"><CheckBox IsChecked="{Binding ShowHfrSlider}" /><CheckBox IsChecked="{Binding ShowHfrMetric}" /></StackPanel><StackPanel Grid.Row="7" Grid.Column="2" Orientation="Horizontal" Spacing="10"><CheckBox IsChecked="{Binding AutoCalcHfrThreshold}" /><NumericUpDown IsVisible="{Binding AutoCalcHfrThreshold, Converter={StaticResource InverseBooleanConverter}}" Width="190" Minimum="0" Maximum="50" Increment="0.1" Value="{Binding MaxHfr}" FormatString="F2" /></StackPanel><StackPanel Grid.Row="7" Grid.Column="3" Orientation="Horizontal" Spacing="10"><CheckBox IsChecked="{Binding UseScoreHfr}" /><NumericUpDown IsVisible="{Binding UseScoreHfr}" Width="180" Minimum="0" Maximum="5" Increment="0.1" Value="{Binding ScoreWeightHfr}" FormatString="F1" /></StackPanel>
            <TextBlock Grid.Row="8" Text="Eccentricity" VerticalAlignment="Center" /><StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Spacing="12"><CheckBox IsChecked="{Binding ShowEccentricitySlider}" /><CheckBox IsChecked="{Binding ShowEccentricityMetric}" /></StackPanel><StackPanel Grid.Row="8" Grid.Column="2" Orientation="Horizontal" Spacing="10"><CheckBox IsChecked="{Binding AutoCalcEccentricityThreshold}" /><NumericUpDown IsVisible="{Binding AutoCalcEccentricityThreshold, Converter={StaticResource InverseBooleanConverter}}" Width="190" Minimum="0" Maximum="1" Increment="0.01" Value="{Binding MaxEccentricity}" FormatString="F3" /></StackPanel><StackPanel Grid.Row="8" Grid.Column="3" Orientation="Horizontal" Spacing="10"><CheckBox IsChecked="{Binding UseScoreEccentricity}" /><NumericUpDown IsVisible="{Binding UseScoreEccentricity}" Width="180" Minimum="0" Maximum="5" Increment="0.1" Value="{Binding ScoreWeightEccentricity}" FormatString="F1" /></StackPanel>
            <TextBlock Grid.Row="9" Text="Mean background" VerticalAlignment="Center" /><StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal" Spacing="12"><CheckBox IsChecked="{Binding ShowMeanBackgroundSlider}" /><CheckBox IsChecked="{Binding ShowMeanBackgroundMetric}" /></StackPanel><StackPanel Grid.Row="9" Grid.Column="2" Orientation="Horizontal" Spacing="10"><CheckBox IsChecked="{Binding AutoCalcMeanBackgroundThreshold}" /><NumericUpDown IsVisible="{Binding AutoCalcMeanBackgroundThreshold, Converter={StaticResource InverseBooleanConverter}}" Width="190" Minimum="0" Maximum="100000" Increment="50" Value="{Binding MaxMeanBackground}" FormatString="F0" /></StackPanel><StackPanel Grid.Row="9" Grid.Column="3" Orientation="Horizontal" Spacing="10"><CheckBox IsChecked="{Binding UseScoreBackground}" /><NumericUpDown IsVisible="{Binding UseScoreBackground}" Width="180" Minimum="0" Maximum="5" Increment="0.1" Value="{Binding ScoreWeightBackground}" FormatString="F1" /></StackPanel>
            <TextBlock Grid.Row="10" Text="Stars" VerticalAlignment="Center" /><StackPanel Grid.Row="10" Grid.Column="1" Orientation="Horizontal" Spacing="12"><CheckBox IsChecked="{Binding ShowStarsSlider}" /><CheckBox IsChecked="{Binding ShowStarsMetric}" /></StackPanel><StackPanel Grid.Row="10" Grid.Column="2" Orientation="Horizontal" Spacing="10"><CheckBox IsChecked="{Binding AutoCalcStarsThreshold}" /><NumericUpDown IsVisible="{Binding AutoCalcStarsThreshold, Converter={StaticResource InverseBooleanConverter}}" Width="190" Minimum="0" Maximum="50000" Increment="10" Value="{Binding MinStars}" FormatString="F0" /></StackPanel><StackPanel Grid.Row="10" Grid.Column="3" Orientation="Horizontal" Spacing="10"><CheckBox IsChecked="{Binding UseScoreStars}" /><NumericUpDown IsVisible="{Binding UseScoreStars}" Width="180" Minimum="0" Maximum="5" Increment="0.1" Value="{Binding ScoreWeightStars}" FormatString="F1" /></StackPanel>
            <TextBlock Grid.Row="11" Text="Score" VerticalAlignment="Center" /><StackPanel Grid.Row="11" Grid.Column="1" Orientation="Horizontal" Spacing="12"><CheckBox IsChecked="{Binding ShowScoreSlider}" /><CheckBox IsChecked="{Binding ShowScoreMetric}" /></StackPanel><StackPanel Grid.Row="11" Grid.Column="2" Orientation="Horizontal" Spacing="10"><CheckBox IsChecked="{Binding AutoCalcScoreThreshold}" /><NumericUpDown IsVisible="{Binding AutoCalcScoreThreshold, Converter={StaticResource InverseBooleanConverter}}" Width="190" Minimum="0" Maximum="5" Increment="0.1" Value="{Binding MinScore}" FormatString="F2" /></StackPanel><TextBlock Grid.Row="11" Grid.Column="3" Text="-" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <Border Grid.Row="3" Margin="0,10,0,0" Padding="10,8" Background="#14171A" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="4">
      <Grid ColumnDefinitions="2*,1.4*,2*" ColumnSpacing="10">
        <TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding BottomStatusText}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" FontSize="11" Foreground="#9DB0C2" Text="{Binding PerformanceText}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
        <TextBlock Grid.Column="2" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding SettingsPath}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" />
      </Grid>
    </Border>
  </Grid>
</Window>