<Window x:Class="blink_o_mat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:controls="clr-namespace:blink_o_mat.Controls"
        xmlns:converters="clr-namespace:blink_o_mat.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
         Background="{StaticResource WindowBackgroundBrush}"
         Foreground="{StaticResource TextBrush}"
        Title="Rejector" Height="1000" Width="1550" Icon="/6dd39f16-9f8b-454e-86c4-b44c409cb647.png"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Window.Resources>
        <converters:RatioToGridLengthConverter x:Key="RatioToGridLength" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="W" Modifiers="Control+Alt" Command="{Binding DebugShowUpdateBannerCommand}" />
    </Window.InputBindings>
    <Grid Margin="12" Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Session save/load icons -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                <Button Command="{Binding SaveSessionCommand}" ToolTip="Save current session — settings, filters, sort order, and per-frame accepted/rejected state — to a .boms file"
                        Width="28" Height="28" Padding="4" Margin="0,0,4,0">
                    <Path Data="M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3M19,19H5V5H16.17L19,7.83V19M12,12C10.34,12 9,13.34 9,15S10.34,18 12,18 15,16.66 15,15 13.66,12 12,12M6,6H15V10H6V6Z"
                          Fill="{StaticResource TextBrush}" Stretch="Uniform" Width="14" Height="14" />
                </Button>
                <Button Command="{Binding LoadSessionCommand}" ToolTip="Load a previously saved .boms session; new files in the folder are picked up and appended automatically"
                        Width="28" Height="28" Padding="4">
                    <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20M12,11L16,15H13.5V19H10.5V15H8L12,11Z"
                          Fill="{StaticResource TextBrush}" Stretch="Uniform" Width="14" Height="14" />
                </Button>
            </StackPanel>

            <Grid Grid.Column="1" Margin="0,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Hyperlink Command="{Binding BrowseInputCommand}" Foreground="{StaticResource TextBrush}" ToolTip="Click to browse for the folder containing your FITS/XISF light frames">Input folder:</Hyperlink>
                </TextBlock>
                <TextBox Grid.Column="1" Text="{Binding InputFolder, UpdateSourceTrigger=PropertyChanged}" ToolTip="Path to the folder containing your raw light frames" VerticalAlignment="Center" />
                <CheckBox Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0" IsChecked="{Binding IncludeSubfolders}" ToolTip="Include subfolders recursively">Subfolders</CheckBox>
            </Grid>

            <Grid Grid.Column="2" Margin="0,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Hyperlink Command="{Binding BrowseRejectedCommand}" Foreground="{StaticResource TextBrush}" ToolTip="Click to browse for the destination folder where rejected frames will be moved">Rejected folder:</Hyperlink>
                </TextBlock>
                <TextBox Grid.Column="1" Text="{Binding RejectedFolder, UpdateSourceTrigger=PropertyChanged}" ToolTip="Destination folder for rejected frames — subfolder structure relative to the input folder is preserved" VerticalAlignment="Center" />
            </Grid>

            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Button Padding="12,3" Content="Load Frames" Command="{Binding LoadFramesCommand}" ToolTip="Scan the input folder and load all FITS/XISF frames for analysis" Margin="0,0,8,0" />
                <Button x:Name="RejectButton" Padding="12,3" Content="Reject"
                        Click="RejectButton_Click"
                        IsEnabled="{Binding MoveRejectedEnabled}"
                        ToolTip="Move all rejected frames to the rejected folder"
                        Background="#99261414" BorderBrush="#C0392B" Foreground="#FFECACAC">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="#99261414" />
                            <Setter Property="BorderBrush" Value="#C0392B" />
                            <Setter Property="Foreground" Value="#FFECACAC" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#CC3D0C0C" />
                                    <Setter Property="BorderBrush" Value="#E74C3C" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Update banner — only visible when a newer version is available -->
        <Border Grid.Row="1"
                Margin="0,0,0,8"
                Padding="10,7"
                Background="#1A3A2A"
                BorderBrush="#2E7D52"
                BorderThickness="1"
                CornerRadius="3">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding UpdateBanner.IsVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- Update icon -->
                <Path Grid.Row="0" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center"
                      Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                      Fill="#4CAF82" Stretch="Uniform" Width="16" Height="16" />
                <!-- Message (clickable) -->
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center"
                               Text="{Binding UpdateBanner.Message}"
                               Foreground="#B2DFCC" FontSize="12"
                               Cursor="Hand">
                        <TextBlock.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding UpdateBanner.DownloadAndUpdateCommand}" />
                        </TextBlock.InputBindings>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="TextDecorations" Value="Underline" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12">
                        <Hyperlink Foreground="#80BFAA"
                                   Command="{Binding UpdateBanner.ShowReleaseNotesCommand}">
                            What's new?
                        </Hyperlink>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UpdateBanner.HasReleaseNotes}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <!-- Download and install button -->
                <Button Grid.Row="0" Grid.Column="2" Margin="10,0,6,0" Padding="8,3" FontSize="11"
                        Content="{Binding UpdateBanner.UpdateButtonText}"
                        Command="{Binding UpdateBanner.DownloadAndUpdateCommand}"
                        Background="#2E7D52" BorderBrush="#4CAF82" Foreground="#FFFFFF">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="#2E7D52" />
                            <Setter Property="BorderBrush" Value="#4CAF82" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#388E5F" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <!-- Dismiss button -->
                <Button Grid.Row="0" Grid.Column="3" Width="22" Height="22" Padding="2"
                        Command="{Binding UpdateBanner.DismissCommand}"
                        ToolTip="Dismiss"
                        Background="Transparent" BorderBrush="Transparent" Foreground="#4CAF82">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1F4A36" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                          Fill="#4CAF82" Stretch="Uniform" Width="10" Height="10" />
                </Button>
                <!-- Status message (shown during download) -->
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                           Text="{Binding UpdateBanner.StatusMessage}"
                           Foreground="#80BFAA" FontSize="11" Margin="0,2,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UpdateBanner.IsDownloading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                <StackPanel>
                    <Border Padding="10" Margin="0,0,0,10" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Margin="0,0,0,6" Text="Session" />
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding SessionFocalLengthMm, StringFormat=Focal: {0:F1} mm, TargetNullValue=Focal: n/a}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" Text="{Binding SessionPixelSizeUm, StringFormat=Pixel: {0:F2} µm, TargetNullValue=Pixel: n/a}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Padding="10" Margin="0,0,0,10" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Margin="0,0,0,6" Text="Frame summary" />

                            <!-- Totals row -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Total frames" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding TotalFrameCount}" FontSize="11" />
                            </Grid>

                            <!-- Overall accepted / rejected bar -->
                            <Grid Height="7" Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding OverallAcceptedRatio, Converter={StaticResource RatioToGridLength}}" />
                                    <ColumnDefinition Width="{Binding OverallAcceptedRatio, Converter={StaticResource RatioToGridLength}, ConverterParameter=invert}" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#5CA36E" CornerRadius="3,0,0,3" />
                                <Border Grid.Column="1" Background="#B85C5C" CornerRadius="0,3,3,0" />
                            </Grid>

                            <!-- Accepted / Rejected counts -->
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✓ " Foreground="#5CA36E" FontSize="11" />
                                    <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11">
                                        <Run Text="{Binding ApprovedFrameCount, Mode=OneWay}" />
                                        <Run Text=" accepted (" />
                                        <Run Text="{Binding ApprovedFramePercentageText, Mode=OneWay}" />
                                        <Run Text=")" />
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="1" FontWeight="SemiBold" FontSize="11"
                                           Foreground="{StaticResource TextBrush}"
                                           Text="{Binding AcceptedIntegrationTimeText}" />
                            </Grid>
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✕ " Foreground="#B85C5C" FontSize="11" />
                                    <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11">
                                        <Run Text="{Binding RejectedFrameCount, Mode=OneWay}" />
                                        <Run Text=" rejected (" />
                                        <Run Text="{Binding RejectedFramePercentageText, Mode=OneWay}" />
                                        <Run Text=")" />
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                           Text="{Binding TotalIntegrationTimeText, StringFormat=total: {0}}" />
                            </Grid>

                            <!-- Per-filter summaries -->
                            <ItemsControl ItemsSource="{Binding FilterSummaries}" Margin="0,8,0,0">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasMultipleFilterChips}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Single compact row per filter -->
                                        <Grid Margin="0,3,0,0" Height="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Filter name -->
                                            <TextBlock Grid.Column="0" Text="{Binding FilterName}"
                                                       FontSize="10" FontWeight="SemiBold" Foreground="#8FB3FF"
                                                       VerticalAlignment="Center" />

                                            <!-- Bar with counts overlaid -->
                                            <Grid Grid.Column="1" Margin="4,0,6,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding AcceptedRatio, Converter={StaticResource RatioToGridLength}}" />
                                                    <ColumnDefinition Width="{Binding AcceptedRatio, Converter={StaticResource RatioToGridLength}, ConverterParameter=invert}" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#5CA36E" CornerRadius="2,0,0,2" />
                                                <Border Grid.Column="1" Background="#B85C5C" CornerRadius="0,2,2,0" />
                                                <!-- accepted count left-inside -->
                                                <TextBlock Grid.Column="0" FontSize="9" Foreground="#DDFFFFFF"
                                                           HorizontalAlignment="Left" VerticalAlignment="Center"
                                                           Margin="3,0,0,0" Text="{Binding Accepted, Mode=OneWay}" />
                                                <!-- rejected count right-inside -->
                                                <TextBlock Grid.Column="1" FontSize="9" Foreground="#DDFFFFFF"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           Margin="0,0,3,0">
                                                    <Run Text="{Binding Rejected, Mode=OneWay}" />
                                                </TextBlock>
                                            </Grid>

                                            <!-- Integration time -->
                                            <TextBlock Grid.Column="2" FontSize="10"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding IntegrationTimeText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Padding="10" Margin="0,0,0,10" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontWeight="SemiBold" VerticalAlignment="Center" Text="Automatic rejection" Foreground="{StaticResource TextBrush}" />
                                <Button Grid.Column="1" Margin="6,0,4,0" Padding="6,2" MinWidth="0"
                                        Background="{StaticResource PanelBackgroundBrush}"
                                        Foreground="{StaticResource TextBrush}"
                                        BorderBrush="{StaticResource PanelBorderBrush}"
                                        ToolTip="Reset thresholds for the selected filter group(s) to their current maxima/minima"
                                        Command="{Binding ResetThresholdsCommand}">
                                    <TextBlock Text="&#x21BB;" FontSize="14" Foreground="{StaticResource TextBrush}" />
                                </Button>
                                <ToggleButton x:Name="RejectionScopeToggle" Grid.Column="2" Padding="8,2" MinWidth="110"
                                              Background="{StaticResource PanelBackgroundBrush}"
                                              Foreground="{StaticResource TextBrush}"
                                              BorderBrush="{StaticResource PanelBorderBrush}"
                                              ToolTip="Limit automatic rejection and scoring to selected filter groups">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasRejectionScopeChips}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <!-- Keep the toggle subtle when the popup is open: the global
                                                     ToggleButton style flips Background to the bright accent
                                                     SelectionBrush on IsChecked, which is too loud here. -->
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding RejectionScopeSummary}" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="  &#x25BC;" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                                    </StackPanel>
                                </ToggleButton>
                                <Popup PlacementTarget="{Binding ElementName=RejectionScopeToggle}" Placement="Bottom"
                                       IsOpen="{Binding IsChecked, ElementName=RejectionScopeToggle, Mode=TwoWay}"
                                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Padding="8" MinWidth="180">
                                        <Border.Resources>
                                            <!-- Local CheckBox style: forces the chip-row foreground to stay
                                                 readable when the group header is highlighted / hovered by the
                                                 system. Without this the dark theme's Highlight* system colors
                                                 leak into the checkbox content and make labels disappear. -->
                                            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
                                            </Style>
                                        </Border.Resources>
                                        <StackPanel>
                                            <!-- Quick-select presets -->
                                            <WrapPanel Margin="0,0,0,6">
                                                <Button Content="All"
                                                        Padding="6,1" Margin="0,0,4,4" FontSize="11"
                                                        Command="{Binding SelectAllScopeCommand}"
                                                        ToolTip="Select every filter" />
                                                <Button Content="Narrowband"
                                                        Padding="6,1" Margin="0,0,4,4" FontSize="11"
                                                        Command="{Binding SelectNarrowbandScopeCommand}"
                                                        ToolTip="Select only Ha, Oiii and Sii" />
                                                <Button Content="LRGB"
                                                        Padding="6,1" Margin="0,0,4,4" FontSize="11"
                                                        Command="{Binding SelectLrgbScopeCommand}"
                                                        ToolTip="Select L, R, G and B" />
                                                <Button Content="RGB"
                                                        Padding="6,1" Margin="0,0,4,4" FontSize="11"
                                                        Command="{Binding SelectRgbScopeCommand}"
                                                        ToolTip="Select only R, G and B (no Luminance)" />
                                            </WrapPanel>
                                            <ItemsControl ItemsSource="{Binding RejectionScopeGroups}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,0,6">
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="9" FontWeight="Bold"
                                                                       Foreground="#888" Margin="0,2,0,2" />
                                                            <ItemsControl ItemsSource="{Binding Chips}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <CheckBox Margin="6,2,0,2"
                                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <Border Width="10" Height="10" CornerRadius="2"
                                                                                        Margin="0,0,6,0" VerticalAlignment="Center"
                                                                                        Background="{Binding BackgroundBrush}"
                                                                                        BorderBrush="{Binding BorderBrush}"
                                                                                        BorderThickness="1" />
                                                                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                                                            </StackPanel>
                                                                        </CheckBox>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                            <controls:MetricSliderControl
                                Label="Min. trail confidence"
                                Value="{Binding MinSatelliteConfidence, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Minimum="1" Maximum="100" TickFrequency="5" LargeChange="10"
                                Decimals="0" Suffix="%"
                                ShowRejectCount="True"
                                RejectCount="{Binding SatelliteTrailRejectedFrameCount}" />
                            <controls:MetricSliderControl
                                Label="Max FWHM"
                                Value="{Binding MaxFwhm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Minimum="0" Maximum="15" TickFrequency="0.25" LargeChange="1"
                                Decimals="2"
                                ShowRejectCount="True"
                                RejectCount="{Binding FwhmRejectedFrameCount}" />
                            <controls:MetricSliderControl
                                Label="Min SQM"
                                Value="{Binding MinSqm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Minimum="0" Maximum="30" TickFrequency="0.05" LargeChange="1"
                                Decimals="2"
                                ShowRejectCount="True"
                                RejectCount="{Binding SqmRejectedFrameCount}" />
                            <controls:MetricSliderControl
                                Label="Max sky temp"
                                Value="{Binding MaxSkyTemp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Minimum="-50" Maximum="50" TickFrequency="1" LargeChange="5"
                                Decimals="1"
                                ShowRejectCount="True"
                                RejectCount="{Binding SkyTempRejectedFrameCount}" />
                            <controls:MetricSliderControl
                                Label="Max HFR"
                                Value="{Binding MaxHfr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Minimum="0" Maximum="10" TickFrequency="0.1" LargeChange="1"
                                Decimals="2"
                                ShowRejectCount="True"
                                RejectCount="{Binding HfrRejectedFrameCount}" />
                            <controls:MetricSliderControl
                                Label="Max Eccentricity"
                                Value="{Binding MaxEccentricity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Minimum="0" Maximum="1" TickFrequency="0.01" LargeChange="0.1"
                                Decimals="3"
                                ShowRejectCount="True"
                                RejectCount="{Binding EccentricityRejectedFrameCount}" />
                            <controls:MetricSliderControl
                                Label="Max Mean Background"
                                Value="{Binding MaxMeanBackground, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Minimum="0" Maximum="10000" TickFrequency="50" LargeChange="500"
                                Decimals="1"
                                ShowRejectCount="True"
                                RejectCount="{Binding MeanBackgroundRejectedFrameCount}" />
                            <controls:MetricSliderControl
                                Label="Min Stars"
                                Value="{Binding MinStars, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Minimum="0" Maximum="1000" TickFrequency="5" LargeChange="50"
                                Decimals="0"
                                ShowRejectCount="True"
                                RejectCount="{Binding StarCountRejectedFrameCount}" />
                            <controls:MetricSliderControl
                                Label="Min Score"
                                Value="{Binding MinScore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Minimum="0" Maximum="5" TickFrequency="0.1" LargeChange="0.5"
                                Decimals="1"
                                ShowRejectCount="True"
                                RejectCount="{Binding ScoreRejectedFrameCount}" />
                        </StackPanel>
                    </Border>

                    <Border Padding="10" Margin="0,0,0,10" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                        
                            <StackPanel Margin="0,8,0,0">
                                <CheckBox Content="Auto-stretch each frame individually" IsChecked="{Binding AutoStretchPerFrame}" Margin="0,0,0,8" ToolTip="When enabled, STF parameters are computed independently for each frame instead of using a single global stretch" />
                                <controls:MetricSliderControl
                                    Label="STF Target Background"
                                    Value="{Binding StfTargetBackground, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Minimum="0.01" Maximum="0.5" TickFrequency="0.01" LargeChange="0.05"
                                    Decimals="2" />
                            </StackPanel>
                       
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- HEADER BAR -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- GROUP 1: Visibility (Accepted / Rejected) -->
                    <Border Grid.Column="0" Margin="0,0,8,0" Padding="8,4,8,6"
                            Background="#1A1A1A" BorderBrush="#333" BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="VISIBILITY" FontSize="9" FontWeight="Bold"
                                       Foreground="#666" Margin="0,0,0,4" />
                            <WrapPanel VerticalAlignment="Center">
                                <ToggleButton IsChecked="{Binding ShowAccepted, Mode=TwoWay}"
                                             Margin="0,0,6,0" Padding="12,4" BorderThickness="1" FontWeight="SemiBold"
                                             ToolTip="Show or hide accepted (not rejected) frames in the list">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Background" Value="#223A6B46" />
                                            <Setter Property="Foreground" Value="#FFE9F8EE" />
                                            <Setter Property="BorderBrush" Value="#5CA36E" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Background" Value="#2F3FAE63" />
                                                    <Setter Property="BorderBrush" Value="#7AD68E" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="False">
                                                    <Setter Property="Background" Value="#161616" />
                                                    <Setter Property="Foreground" Value="#CCBDBDBD" />
                                                    <Setter Property="BorderBrush" Value="#444" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                    <TextBlock Text="Accepted" />
                                </ToggleButton>

                                <ToggleButton IsChecked="{Binding ShowRejected, Mode=TwoWay}"
                                             Margin="0" Padding="12,4" BorderThickness="1" FontWeight="SemiBold"
                                             ToolTip="Show or hide rejected frames in the list">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Background" Value="#224E2A2A" />
                                            <Setter Property="Foreground" Value="#FFF9EAEA" />
                                            <Setter Property="BorderBrush" Value="#B85C5C" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Background" Value="#33C45F5F" />
                                                    <Setter Property="BorderBrush" Value="#E07A7A" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="False">
                                                    <Setter Property="Background" Value="#161616" />
                                                    <Setter Property="Foreground" Value="#CCBDBDBD" />
                                                    <Setter Property="BorderBrush" Value="#444" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                    <TextBlock Text="Rejected" />
                                </ToggleButton>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- GROUP 2: Filters (R, G, B, �) � only shown when chips exist -->
                    <Border Grid.Column="1" Margin="0,0,8,0" Padding="8,4,8,6"
                            Background="#1A1A1A" BorderBrush="#333" BorderThickness="1" CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasFilterChips}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="FILTERS" FontSize="9" FontWeight="Bold"
                                       Foreground="#666" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding FilterChips}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                     Margin="0,0,6,0" Padding="10,4" BorderThickness="1" FontWeight="SemiBold"
                                                     Background="{Binding BackgroundBrush}"
                                                     Foreground="{Binding ForegroundBrush}"
                                                     BorderBrush="{Binding BorderBrush}">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton">
                                                    <Setter Property="Cursor" Value="Hand" />
                                                    <Setter Property="Opacity" Value="1.0" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsChecked" Value="False">
                                                            <Setter Property="Background" Value="#0A0A0A" />
                                                            <Setter Property="Foreground" Value="#55777777" />
                                                            <Setter Property="BorderBrush" Value="#222" />
                                                            <Setter Property="Opacity" Value="0.45" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- spacer -->
                    <Border Grid.Column="2" />

                    <!-- GROUP 3: Alignment -->
                    <Border Grid.Column="3" Margin="0,0,8,0" Padding="8,4,8,6"
                            Background="#1A1A1A" BorderBrush="#333" BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="ALIGNMENT" FontSize="9" FontWeight="Bold"
                                       Foreground="#666" Margin="0,0,0,4" />
                            <ToggleButton IsChecked="{Binding IsAlignmentEnabled, Mode=TwoWay}"
                                          Height="26" Padding="8,0" BorderThickness="1"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          ToolTip="Align all frames using detected per-frame pixel shifts. When off, frames are shown in their raw (un-shifted) position.">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Background" Value="#161616" />
                                        <Setter Property="Foreground" Value="#CCBDBDBD" />
                                        <Setter Property="BorderBrush" Value="#444" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="&#x2316;" FontFamily="Segoe UI Symbol" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                                                            <TextBlock Text="Align frames" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" />
                                                        </StackPanel>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Background" Value="#22426B9F" />
                                                <Setter Property="BorderBrush" Value="#6D88C4" />
                                                <Setter Property="Foreground" Value="#FFE8F0FF" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                        </StackPanel>
                    </Border>

                    <!-- GROUP 4: Sort -->
                    <Border Grid.Column="4" Padding="8,4,8,6"
                            Background="#1A1A1A" BorderBrush="#333" BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="SORT" FontSize="9" FontWeight="Bold"
                                       Foreground="#666" Margin="0,0,0,4" />
                            <DockPanel LastChildFill="False">
                                <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding SortRules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <WrapPanel Margin="0,0,0,4">
                                                <!-- Field selector -->
                                                <ComboBox Height="26" Width="160" Margin="0,0,6,0"
                                                          ItemsSource="{Binding DataContext.SortFieldOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding SelectedField, Mode=TwoWay}"
                                                          DisplayMemberPath="DisplayName" />

                                                <!-- Asc / Desc toggle chip -->
                                                <ToggleButton IsChecked="{Binding IsDescending, Mode=TwoWay}"
                                                             Height="26" Width="32" Margin="0,0,6,0"
                                                             Padding="0" FontSize="14" ToolTip="Toggle between ascending (▲) and descending (▼) sort order">
                                                    <ToggleButton.Style>
                                                        <Style TargetType="ToggleButton">
                                                            <Setter Property="Background" Value="#161616" />
                                                            <Setter Property="Foreground" Value="#CCBDBDBD" />
                                                            <Setter Property="BorderBrush" Value="#444" />
                                                            <Setter Property="BorderThickness" Value="1" />
                                                            <Setter Property="Cursor" Value="Hand" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ToggleButton">
                                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                            <TextBlock x:Name="Arrow" Text="&#x25B2;" FontFamily="Segoe UI Symbol" FontSize="10"
                                                                                       Foreground="{TemplateBinding Foreground}"
                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsChecked" Value="True">
                                                                                <Setter TargetName="Arrow" Property="Text" Value="&#x25BC;" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter Property="Background" Value="#22426B9F" />
                                                                    <Setter Property="BorderBrush" Value="#6D88C4" />
                                                                    <Setter Property="Foreground" Value="#FFE8F0FF" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ToggleButton.Style>
                                                </ToggleButton>

                                                <!-- Remove rule -->
                                                <Button Height="26" Width="26" Padding="0"
                                                        FontWeight="SemiBold" FontSize="13"
                                                        Content="-" Margin="0"
                                                        ToolTip="Remove this sort rule"
                                                        Command="{Binding DataContext.RemoveSortRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </WrapPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Add rule -->
                                <Button DockPanel.Dock="Right" Height="26" Padding="10,0" Margin="8,0,0,0"
                                        Content="+ Field" Command="{Binding AddSortRuleCommand}"
                                        VerticalAlignment="Top" ToolTip="Add another sort field" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <ListView Grid.Row="1"
                      x:Name="FramesListView"
                      ItemsSource="{Binding FilteredFrames}"
                      SelectedItem="{Binding SelectedFrame, Mode=TwoWay}"
                      SelectionChanged="FramesListView_SelectionChanged"
                      HorizontalContentAlignment="Stretch"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.CanContentScroll="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      VirtualizingPanel.CacheLengthUnit="Item"
                      VirtualizingPanel.CacheLength="1">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <controls:FrameListItemView />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Margin="0,10,0,0" Padding="8,6" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Status}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                    <!-- Performance indicators (fixed-width columns to prevent layout shifts) -->
                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.65">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Performance.Cpu}"  FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Performance.Ram}"  FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Grid.Column="2" Text="{Binding Performance.Net}"  FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Grid.Column="3" Text="{Binding Performance.Disk}" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextBrush}" />
                    </Grid>
                </Grid>

                <ProgressBar Grid.Row="1"
                             Margin="0,6,0,0"
                             Height="12"
                             Minimum="0"
                             Maximum="{Binding ProgressMaximum, Mode=OneWay}"
                             Value="{Binding ProgressValue, Mode=OneWay}">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProgressVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </Grid>
        </Border>
    </Grid>
</Window>