<UserControl x:Class="blink_o_mat.Controls.MetricSliderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="290" d:DesignHeight="46"
             x:Name="Root">
    <UserControl.Resources>
        <!-- slim Slider track style -->
        <Style x:Key="SlimSliderStyle" TargetType="Slider">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid x:Name="GridRoot" Height="18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border x:Name="TrackBorder"
                                    Height="4"
                                    VerticalAlignment="Center"
                                    Background="#3A3A3A"
                                    BorderBrush="#555"
                                    BorderThickness="1"
                                    CornerRadius="2" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" Opacity="0">
                                        <RepeatButton.Style>
                                            <Style TargetType="RepeatButton">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="RepeatButton">
                                                            <Border Height="4" VerticalAlignment="Center" Background="#569CD6" CornerRadius="2,0,0,2" />
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </RepeatButton.Style>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Opacity="0">
                                        <RepeatButton.Style>
                                            <Style TargetType="RepeatButton">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="RepeatButton">
                                                            <Border Background="Transparent" />
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </RepeatButton.Style>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb">
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="OverridesDefaultStyle" Value="True" />
                                                <Setter Property="Width" Value="12" />
                                                <Setter Property="Height" Value="18" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="#C8C8C8" CornerRadius="3" />
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#FFFFFF" />
                                                                </Trigger>
                                                                <Trigger Property="IsDragging" Value="True">
                                                                    <Setter Property="Background" Value="#569CD6" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="0,0,0,6">
        <!-- Row 1: label left, rejects right -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding Label, ElementName=Root}"
                       FontSize="11"
                       Foreground="#B8B8B8"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       FontSize="10"
                       Foreground="#888"
                       VerticalAlignment="Center"
                       Text="{Binding RejectCount, ElementName=Root, StringFormat={}Rejects: {0}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowRejectCount, ElementName=Root}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- Row 2: slider + value display/edit -->
        <Grid Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="52" />
            </Grid.ColumnDefinitions>

            <Slider Grid.Column="0"
                    x:Name="TheSlider"
                    Style="{StaticResource SlimSliderStyle}"
                    VerticalAlignment="Center"
                    Minimum="{Binding Minimum, ElementName=Root}"
                    Maximum="{Binding Maximum, ElementName=Root}"
                    TickFrequency="{Binding TickFrequency, ElementName=Root}"
                    IsSnapToTickEnabled="False"
                    SmallChange="{Binding TickFrequency, ElementName=Root}"
                    LargeChange="{Binding LargeChange, ElementName=Root}" />

            <!-- value label (click to edit) -->
            <Border Grid.Column="1"
                    x:Name="ValueBorder"
                    Margin="6,0,0,0"
                    Background="Transparent"
                    Cursor="IBeam"
                    MouseLeftButtonDown="ValueBorder_MouseLeftButtonDown">
                <Grid>
                    <!-- display TextBlock -->
                    <TextBlock x:Name="ValueDisplay"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#F0C060"
                               Text="{Binding DisplayText, ElementName=Root}" />

                    <!-- edit TextBox (hidden by default, zoomed in slightly) -->
                    <TextBox x:Name="ValueEditor"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Center"
                             FontSize="13"
                             FontWeight="SemiBold"
                             Foreground="#F0C060"
                             Background="#252525"
                             BorderBrush="#569CD6"
                             BorderThickness="0,0,0,1"
                             Padding="2,1"
                             Visibility="Collapsed"
                             TextAlignment="Right"
                             LostFocus="ValueEditor_LostFocus"
                             KeyDown="ValueEditor_KeyDown" />
                </Grid>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
