<UserControl x:Class="blink_o_mat.Controls.FrameListItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:blink_o_mat.Converters"
             mc:Ignorable="d"
              d:DesignHeight="210"
              d:DesignWidth="1240">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#7AA7FF" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="MetricNameStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#D0D0D0" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="12,0,0,2" />
        </Style>
        <Style x:Key="ChipBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Background" Value="#202224" />
        </Style>
        <Style x:Key="PreviewTagStyle" TargetType="Border">
            <Setter Property="Background" Value="#AA1C1C1C" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="6" />
        </Style>
    </UserControl.Resources>
    <Border BorderBrush="{StaticResource PanelBorderBrush}" Background="{StaticResource PanelBackgroundAltBrush}" BorderThickness="1" Padding="6" Margin="0,0,0,8" CornerRadius="4">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{StaticResource PanelBackgroundAltBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPreviewActive}" Value="True">
                        <Setter Property="BorderBrush" Value="Gold" />
                        <Setter Property="BorderThickness" Value="2" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid Background="{DynamicResource ListItem}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="342*" />
                <ColumnDefinition Width="41*" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" LastChildFill="True" Margin="0,0,10,6">
                <Border DockPanel.Dock="Right" Background="{Binding QualityBackgroundBrush}" CornerRadius="5" Padding="10,3" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="{Binding QualityLabel}" Foreground="{Binding QualityBrush}" FontWeight="Bold" FontSize="12" />
                </Border>
                <TextBlock DockPanel.Dock="Left"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#F0F0F0"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding FileName}"
                           ToolTip="{Binding FileName}"
                           VerticalAlignment="Center" />
            </DockPanel>

            <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="145" Height="145" Margin="0,0,6,0" BorderBrush="#3B3E42" BorderThickness="1" Background="#151618" CornerRadius="4">
                    <Border.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.OpenPreviewCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" />
                    </Border.InputBindings>
                    <Grid>
                        <Image Stretch="UniformToFill" Source="{Binding ThumbnailImage}" ToolTip="Click to open preview" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Border Style="{StaticResource PreviewTagStyle}">
                            <TextBlock Text="Frame" FontSize="11" FontWeight="SemiBold" Foreground="#EEEEEE" />
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Width="145" Height="145" BorderBrush="#3B3E42" BorderThickness="1" Background="#151618" CornerRadius="4">
                    <Border.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.OpenPreviewCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" />
                    </Border.InputBindings>
                    <Grid>
                        <Image Stretch="UniformToFill" Source="{Binding RoiImage}" ToolTip="Click to open preview" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Border Style="{StaticResource PreviewTagStyle}">
                            <TextBlock Text="ROI" FontSize="11" FontWeight="SemiBold" Foreground="#EEEEEE" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,10,0" Grid.ColumnSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="{Binding TimestampDisplay}" Foreground="#BBBBBB" FontSize="12" Margin="0,0,12,0" />
                    <TextBlock Text="•" Foreground="#666666" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding ExposureDisplay}" Foreground="#BBBBBB" FontSize="12" Margin="0,0,12,0" />
                    <TextBlock Text="•" Foreground="#666666" Margin="0,0,12,0" />
                    <TextBlock Text="Filter: " Foreground="#888888" FontSize="12" />
                    <Border Width="9" Height="9" CornerRadius="5"
                            VerticalAlignment="Center" Margin="0,0,5,0"
                            Background="{Binding FilterIndicatorBrush}" />
                    <TextBlock Text="{Binding FilterDisplay}" Foreground="#BBBBBB" FontSize="12" Margin="0,0,12,0" />
                </WrapPanel>

                <WrapPanel Grid.Row="1">
                    <Border Style="{StaticResource ChipBorderStyle}" BorderBrush="{Binding FwhmIndicatorBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="FWHM" Foreground="#A0A0A0" FontSize="11" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding FwhmArcsecDisplay}" Foreground="{Binding FwhmIndicatorBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ChipBorderStyle}" BorderBrush="{Binding EccentricityIndicatorBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ECC" Foreground="#A0A0A0" FontSize="11" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Metrics.Eccentricity, StringFormat={}{0:F3}}" Foreground="{Binding EccentricityIndicatorBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ChipBorderStyle}" BorderBrush="{Binding HfrIndicatorBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="HFR" Foreground="#A0A0A0" FontSize="11" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Metrics.Hfr, StringFormat={}{0:F2}}" Foreground="{Binding HfrIndicatorBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ChipBorderStyle}" BorderBrush="{Binding StarsIndicatorBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="STARS" Foreground="#A0A0A0" FontSize="11" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Metrics.StarCount}" Foreground="{Binding StarsIndicatorBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ChipBorderStyle}" BorderBrush="{Binding TrailIndicatorBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="TRAIL" Foreground="#A0A0A0" FontSize="11" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding TrailText}" Foreground="{Binding TrailIndicatorBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ChipBorderStyle}" BorderBrush="#4C9AFF">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SQM" Foreground="#A0A0A0" FontSize="11" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding SqmDisplay}" Foreground="#DDEBFF" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <Grid Grid.Row="2" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="#2E3134" BorderThickness="0,0,1,0" Padding="0,4,8,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="OPTICS" />
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource MetricNameStyle}" Text="FWHM (px)" />
                                <TextBlock Grid.Column="1" Style="{StaticResource MetricValueStyle}" Text="{Binding Metrics.Fwhm, StringFormat={}{0:F2}}" />
                                <TextBlock Grid.Row="1" Style="{StaticResource MetricNameStyle}" Text="FWHM (arcsec)" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource MetricValueStyle}" Text="{Binding FwhmArcsecDisplay}" />
                                <TextBlock Grid.Row="2" Style="{StaticResource MetricNameStyle}" Text="HFR" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource MetricValueStyle}" Text="{Binding Metrics.Hfr, StringFormat={}{0:F2}}" />
                                <TextBlock Grid.Row="3" Style="{StaticResource MetricNameStyle}" Text="Eccentricity" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource MetricValueStyle}" Text="{Binding Metrics.Eccentricity, StringFormat={}{0:F3}}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" BorderBrush="#2E3134" BorderThickness="0,0,1,0" Padding="0,4,8,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="BACKGROUND" />
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource MetricNameStyle}" Text="Mean BG" />
                                <TextBlock Grid.Column="1" Style="{StaticResource MetricValueStyle}" Text="{Binding Metrics.MeanBackground, StringFormat={}{0:F1}}" />
                                <TextBlock Grid.Row="1" Style="{StaticResource MetricNameStyle}" Text="Median" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource MetricValueStyle}" Text="{Binding Metrics.Median, StringFormat={}{0:F1}}" />
                                <TextBlock Grid.Row="2" Style="{StaticResource MetricNameStyle}" Text="MAD" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource MetricValueStyle}" Text="{Binding Metrics.Mad, StringFormat={}{0:F1}}" />
                                <TextBlock Grid.Row="3" Style="{StaticResource MetricNameStyle}" Text="SQM" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource MetricValueStyle}" Text="{Binding SqmDisplay}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="4" Margin="0,4,0,0">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="FRAME" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource MetricNameStyle}" Text="Stars" />
                            <TextBlock Grid.Column="1" Style="{StaticResource MetricValueStyle}" Text="{Binding Metrics.StarCount}" />
                            <TextBlock Grid.Row="1" Style="{StaticResource MetricNameStyle}" Text="Sky temp" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource MetricValueStyle}" Text="{Binding SkyTempDisplay}" />
                            <TextBlock Grid.Row="2" Style="{StaticResource MetricNameStyle}" Text="Min / count" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource MetricValueStyle}">
                                <Run Text="{Binding Metrics.Min, StringFormat={}{0:F0}}" />
                                <Run Text=" / " />
                                <Run Text="{Binding Metrics.MinCount, StringFormat={}{0}}" />
                            </TextBlock>
                            <TextBlock Grid.Row="3" Style="{StaticResource MetricNameStyle}" Text="Max / count" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource MetricValueStyle}">
                                <Run Text="{Binding Metrics.Max, StringFormat={}{0:F0}}" />
                                <Run Text=" / " />
                                <Run Text="{Binding Metrics.MaxCount, StringFormat={}{0}}" />
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" Background="#1B1D20" BorderBrush="#303338" BorderThickness="1" CornerRadius="4" Padding="12,10">
                <StackPanel>
                    <TextBlock Text="SCORE" FontSize="11" Foreground="#9A9A9A" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                        <TextBlock Text="{Binding ScoreValueText}" FontSize="34" FontWeight="Bold" Foreground="{Binding QualityBrush}" />
                        <TextBlock Text=" / 5" FontSize="16" Foreground="#C8C8C8" VerticalAlignment="Bottom" Margin="4,0,0,4" />
                    </StackPanel>
                    <ProgressBar Height="12" Margin="0,10,0,14" Minimum="0" Maximum="100" Value="{Binding ScoreProgressPercent, Mode=OneWay}" Foreground="{Binding QualityBrush}" Background="#303338" />
                    <Button Command="{Binding DataContext.ToggleRejectCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                            CommandParameter="{Binding}"
                            FontWeight="SemiBold"
                            Foreground="#F5F5F5"
                            HorizontalContentAlignment="Center"
                            Padding="10,7"
                            BorderThickness="0"
                            Background="{Binding RejectionStateBrush}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="{Binding RejectionStateLabel}" FontWeight="SemiBold" Foreground="#F5F5F5" HorizontalAlignment="Center" />
                    </Button>

                    <!-- Rejection reasons info icon -->
                    <Border Margin="0,6,0,0" HorizontalAlignment="Center"
                            Visibility="{Binding HasRejectionReasons, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Background="#2A2D31" BorderBrush="#FF6B6B" BorderThickness="1"
                                CornerRadius="10" Width="20" Height="20" Cursor="Help">
                            <TextBlock Text="?" FontSize="11" FontWeight="Bold" Foreground="#FF9A9A"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.ToolTip>
                                    <ToolTip MaxWidth="320" Placement="Left">
                                        <StackPanel>
                                            <TextBlock Text="REJECTION REASONS" FontSize="10" FontWeight="Bold"
                                                       Foreground="#FF9A9A" Margin="0,0,0,8" />
                                            <ItemsControl ItemsSource="{Binding RejectionReasons}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,3,0,0">
                                                            <TextBlock Text="▸" Foreground="#FF6B6B" FontSize="11"
                                                                       DockPanel.Dock="Left" Margin="0,0,6,0"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding}" Foreground="#F0F0F0"
                                                                       FontSize="12" TextWrapping="Wrap" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </Border>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>